#!/usr/bin/env python3
"""Real configured harnesses consume project-local attached CQ integrations."""
import argparse
import datetime
import json
import os
from pathlib import Path
import runpy
import shlex
import subprocess
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent
PROFILES = {
    "claude": ("Claude", "claude-opus-5-5", "anthropic", "2.1.280"),
    "codex": ("Codex", "gpt-6-sol", "openai", "0.156.1"),
    "pi": ("Pi", "gpt-5.5", "openai-codex", "0.87.1"),
}
CHILD = {"claude": "Codex", "codex": "Pi", "pi": "Claude"}


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("harness", choices=PROFILES)
    parser.add_argument("--evidence", type=Path, required=True)
    parser.add_argument("--cq", type=Path)
    parser.add_argument("--guardian", type=Path, required=True)
    args = parser.parse_args()
    root = args.evidence.resolve()
    root.mkdir(parents=True, mode=0o700)
    module = runpy.run_path(str(ROOT / "dev/check"), run_name="checks_library")
    env = dict(os.environ)
    checks = module["Checks"](root, env)
    binary = args.cq
    if binary is None:
        cp = checks.classpath()
        binary = root / "cq-jvm"
        binary.write_text("#!/bin/sh\nexec java -cp " + shlex.quote(cp) + ' cq.server.Main "$@"\n')
        binary.chmod(0o700)
    binary = binary.resolve()
    routes = []
    for name, (harness, model, provider, version) in PROFILES.items():
        path = Path(os.environ[f"CQ_{name.upper()}_EXECUTABLE"])
        assert path.is_absolute() and path.is_file()
        routes.append({"harness": harness, "executable": str(path), "model": model, "provider": provider, "version": version, "providerExtensions": [], "providerEnvironment": []})
    repository = root / "consumer"
    repository.mkdir()
    subprocess.run(["git", "init", "--quiet", str(repository)], check=True)
    (repository / "README.md").write_text("# CQ attached consumer\n\nObservation marker: CQ_ATTACHED_CONSUMER_V1.\n")
    subprocess.run(["git", "-C", str(repository), "add", "README.md"], check=True)
    subprocess.run(["git", "-C", str(repository), "-c", "user.name=CQ consumer", "-c", "user.email=cq@example.invalid", "commit", "--quiet", "-m", "Consumer base"], check=True)
    settings = root / "settings.json"
    settings.write_text(json.dumps({"stateRoot": str(root / "sessions"), "guardian": str(args.guardian.resolve()), "harnesses": routes,
        "limits": {"startupMillis": "10000", "executionMillis": "600000", "heartbeatMillis": "2000", "graceMillis": "1000", "killMillis": "3000", "outputBytes": 2097152},
        "checks": [], "integrationTarget": None, "evaluation": {"run": root.name, "scenario": "attached-" + args.harness, "assessor": False}}, indent=2))
    port = module["free_port"]()
    env.update(CQ_HOST="127.0.0.1", CQ_PORT=str(port), CQ_ORIGIN=f"http://127.0.0.1:{port}", CQ_TOKEN=uuid.uuid4().hex, CQ_SESSION=str(uuid.uuid4()))
    token = root / "token"
    token.write_text(env["CQ_TOKEN"] + "\n")
    token.chmod(0o600)
    native_env = {key: value for key, value in env.items() if not key.startswith("CQ_")}
    native_env["CQ_TOKEN_FILE"] = str(token)
    prompt = f"""Use this project's installed CQ integration to run a small Begin workflow in THIS session. You are the Governor; do not launch cq run or another Governor.
Call the CQ session tool with Context first and consume its instructions and complete canonical argument schemas. Activate Begin with empty roots and a fresh UUID. Create exactly one Ready Task titled 'Attached {args.harness} investigation' with body 'Investigate README.md and report the exact observation marker; do not modify files', acceptance ['Find and report the exact observation marker in README.md'], and label 'attached-consumer'. Use the returned project identity and generated Task fields, not guessed fields.
Select Explorer Investigate for this task, acquire the exact retained choice's claim, StartChoice using harness {CHILD[args.harness]}, and poll compact Status until terminal. The host assembles the child input. Do not read/compose full child prompts or results. Release the claim after completion. Do not apply proposals, edit source, dispatch more than one child, or use non-CQ subagents.
Return a concise summary with CQ session ID, task ID, child attempt ID, phase and result handle. If any operation fails, preserve its exact error and stop rather than working around the integration. Do not call shell or filesystem tools to simulate CQ tools or inspect CQ runtime files. A context inspection and actual child dispatch through the installed tools are required.
"""
    (root / "request.txt").write_text(prompt)
    def client(arguments, name):
        with (root / (name + ".stdout")).open("w") as out, (root / (name + ".stderr")).open("w") as err:
            result = subprocess.run([str(binary), *arguments], cwd=repository, env=native_env, stdout=out, stderr=err, timeout=45)
        assert result.returncode == 0, name
    result = {"status": "running", "harness": args.harness, "childHarness": CHILD[args.harness], "routes": routes}
    (root / "result.json").write_text(json.dumps(result, indent=2))
    with checks.database([]):
        with checks.server([str(binary)], "native"):
            client(["init", "--endpoint", env["CQ_ORIGIN"]], "init")
            client(["configure", args.harness, "--settings", str(settings), "--executable", str(binary)], "configure")
            executable = next(route["executable"] for route in routes if route["harness"] == PROFILES[args.harness][0])
            if args.harness == "codex":
                command = [executable, "exec", "--json", "--ephemeral", "--model", PROFILES[args.harness][1], "--dangerously-bypass-approvals-and-sandbox",
                           "-c", f'projects.{json.dumps(str(repository))}.trust_level="trusted"', "-"]
            elif args.harness == "claude":
                command = [executable, "--print", "--output-format", "stream-json", "--verbose", "--model", PROFILES[args.harness][1],
                           "--dangerously-skip-permissions", "--strict-mcp-config", "--mcp-config", str(repository / ".mcp.json"), "--setting-sources", "project"]
            else:
                command = [executable, "--offline", "--mode", "json", "--print", "--no-approve", "--provider", PROFILES[args.harness][2], "--model", PROFILES[args.harness][1]]
            (root / "command.json").write_text(json.dumps(command, indent=2))
            with (root / "native.stdout").open("w") as out, (root / "native.stderr").open("w") as err:
                process = subprocess.Popen(command, cwd=repository, env=native_env, stdin=subprocess.PIPE, stdout=out, stderr=err, text=True)
                try:
                    process.stdin.write(prompt)
                    process.stdin.close()
                    code = process.wait(timeout=900)
                finally:
                    if process.poll() is None:
                        process.kill()
                        process.wait(timeout=10)
            result["exit"] = code
            assert code == 0, "Native outer harness failed; see retained stdout/stderr"
            sessions = list((root / "sessions").iterdir())
            assert len(sessions) == 1, f"Expected one harness-owned host: {sessions}"
            session = sessions[0]
            deadline = time.monotonic() + 20
            while not (session / "delivery/final").exists() and time.monotonic() < deadline:
                time.sleep(0.1)
            assert (session / "delivery/final").exists(), "Attached host did not publish its outer coverage on owner exit"
            run = json.loads((session / "run.json").read_text())
            assert run["ownership"] == "Attached"
            assert not (session / "payload" / run["attempt"]["id"]["value"]).exists(), "An extra Governor was launched"
            children = list((session / "children").iterdir())
            assert len(children) == 1
            receipt = json.loads((children[0] / "receipt.json").read_text())
            assert receipt["phase"] == "Completed" and receipt["usageDelivered"] and receipt["result"], receipt
            ticket = json.loads((children[0] / "ticket.json").read_text())
            assert ticket["profile"]["harness"] == CHILD[args.harness]
            assert "CQ_ATTACHED_CONSUMER_V1" in (children[0] / "publication.json").read_text(), "Native child did not inspect the actual fixture"
            client(["status", "--session", run["attempt"]["session"]["value"]], "usage")
            client(["job", "upload", "--session", str(session)], "replay")
            assert "Acknowledged 0" in (root / "replay.stdout").read_text()
            if args.harness == "pi":
                assert len(list((session / "pi-usage").glob("*/sample.json"))) > 0, "Pi native usage hook did not run"
            result.update(status="passed", session=run["attempt"]["session"], child=receipt,
                          owner=json.loads((session / "owner.json").read_text()), outerPid=process.pid)
            (root / "result.json").write_text(json.dumps(result, indent=2) + "\n")
            print(json.dumps(result), flush=True)


if __name__ == "__main__":
    main()
