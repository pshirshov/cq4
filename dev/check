    def browser_suite(self, name: str):
        for scenario in ["browser", "polish-browser", "query-prefix-check", "archive-browser", "followup-browser", "question-browser", "dialog-races-browser", "dialog-size-browser", "sizing-browser", "completion-browser", "query-local-check", "hold-browser", "wip-browser"]:
            self.run(["node", f"dev/{scenario}.mjs"], f"{name}-{scenario}", COMMAND_TIMEOUT)

    def http_browser(self, command: list[str], name: str):
        saved = {key: self.environment[key] for key in ["CQ_HOST", "CQ_PORT", "CQ_ORIGIN"]}
        try:
            port = free_port()
            self.environment.update(CQ_HOST="127.0.0.1", CQ_PORT=str(port), CQ_ORIGIN=f"http://cq-http.test:{port}")
            with self.server(command, f"{name}-http"):
                self.run(["node", "dev/http-browser.mjs"], f"{name}-http-browser", COMMAND_TIMEOUT)
        finally:
            self.environment.update(saved)

    def restart(self, command: list[str]):
        fixture = str(self.evidence / "restart-fixture.json")
        with self.server(command, "before-crash") as process:
            self.run(["node", "dev/restart.mjs", "seed", fixture], "restart-seed", STARTUP_TIMEOUT)
            process.kill()
            process.wait(timeout=SHUTDOWN_TIMEOUT)
            if process.returncode != -9:
                raise RuntimeError("Restart scenario did not terminate the original server with SIGKILL")
        with self.server(command, "after-crash"):
            self.run(["node", "dev/restart.mjs", "verify", fixture], "restart-verify", STARTUP_TIMEOUT)

