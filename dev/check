    def native(self):
        self.generate()
        classpath = self.classpath()
        traces = self.evidence / "native-traces"
        traces.mkdir()
        binary = self.evidence / "cq"
        with self.database([]):
            self.transport(["java", f"-agentlib:native-image-agent=config-output-dir={traces}/{{pid}}-{{datetime}},config-write-period-secs=1",
                            "-cp", classpath, "cq.server.Main"], "native-agent", False, TRACE_FIXTURE_SCALE)
            config = self.native_config(traces)
            self.run(["native-image", "--no-fallback", "-march=compatibility", "-O1", "-J-Xmx8g", *native_jvm_options(),
                      f"-H:ConfigurationFileDirectories={config}", "-cp", classpath,
                      "cq.server.Main", str(binary)], "native-image", COMMAND_TIMEOUT)
            built = hashlib.sha256(binary.read_bytes()).hexdigest()
            self.quiet_startup(binary, "native")
            self.transport([str(binary)], "native", True, 1)
            if hashlib.sha256(binary.read_bytes()).hexdigest() != built:
                raise RuntimeError("Native executable changed during verification")
            (self.evidence / "native-artifact.json").write_text(json.dumps({
                "path": str(binary), "sha256": built, "bytes": binary.stat().st_size,
                "sourceManifest": "source-sha256.json", "metadataInventory": "native-trace-inventory.json",
            }, indent=2) + "\n")

    def quiet_startup(self, binary: Path, name: str):
        output = self.run([str(binary), ":help"], f"{name}-startup", STARTUP_TIMEOUT)
        if "sun.misc.Unsafe" in output:
            raise RuntimeError(f"{name} executable prints the sun.misc.Unsafe warning; see {name}-startup.log")

    def native_config(self, traces: Path):
        inputs = sorted(path for path in traces.iterdir() if path.is_dir())
        inventory = [{"directory": str(path), "files": sorted(file.name for file in path.glob("*.json"))} for path in inputs]
        record = self.evidence / "native-trace-inventory.json"
        record.write_text(json.dumps(inventory, indent=2) + "\n")
        if len(inputs) < 2 or not all(entry["files"] for entry in inventory):
            raise RuntimeError("Required native metadata collection is absent or incomplete; inspect trace inventory")
        snapshots = self.evidence / "native-merge-inputs"
        snapshots.mkdir()
        for source, entry in zip(inputs, inventory):
            pid = int(source.name.split("-", 1)[0])
            lock = source / ".lock"
            if lock.exists() and lock.read_text().strip() != str(pid):
                raise RuntimeError(f"Native trace owner differs from its directory: {source}")
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                pass
            else:
                raise RuntimeError(f"Native trace owner {pid} still exists; metadata cannot be merged")
            if any(path.name != ".lock" and (not path.is_file() or path.suffix != ".json") for path in source.iterdir()):
                raise RuntimeError(f"Unexpected native trace entries require explicit handling: {source}")
            snapshot = snapshots / source.name
            snapshot.mkdir()
            hashes = {}
            for name in entry["files"]:
                content = (source / name).read_bytes()
                json.loads(content)
                hashes[name] = hashlib.sha256(content).hexdigest()
                (snapshot / name).write_bytes(content)
            if hashes != {name: hashlib.sha256((source / name).read_bytes()).hexdigest() for name in entry["files"]}:
                raise RuntimeError(f"Native metadata changed while being snapshotted: {source}")
            entry.update(ownerPid=pid, ownerExited=True, staleLockRetained=lock.exists(), snapshot=str(snapshot), sha256=hashes)
            record.write_text(json.dumps(inventory, indent=2) + "\n")
        config = self.evidence / "native-config"
        config.mkdir()
        self.run(["native-image-utils", "generate", *[f"--input-dir={snapshots / path.name}" for path in inputs],
                  f"--output-dir={config}"], "native-config-merge", COMMAND_TIMEOUT)
        return config


def verify_test_report(output: str):
    summaries = re.findall(r"Tests: succeeded (\d+), failed (\d+), canceled (\d+), ignored (\d+), pending (\d+)", output)
    if not summaries or any(int(values[0]) == 0 or any(int(value) != 0 for value in values[1:]) for values in summaries):
        raise RuntimeError("Required test report is absent, failed or incomplete, regardless of sbt exit status")
    if "*** FAILED ***" in output or "*** ABORTED ***" in output:
        raise RuntimeError("Required test report contains failure/abort despite sbt exit status")


def native_jvm_options():
    # The image fixes its sun.misc.Unsafe memory-access mode at build time, so the builder JVM receives that .jvmopts setting.
    return ["-J" + line.strip() for line in (ROOT / ".jvmopts").read_text().splitlines()
            if line.strip().startswith("--sun-misc-unsafe-memory-access=")]


def free_port():
    with socket.socket() as listener:
        listener.bind(("127.0.0.1", 0))
        return listener.getsockname()[1]


def generated_hashes():
    return {str(path.relative_to(ROOT)): hashlib.sha256(path.read_bytes()).hexdigest()
            for path in sorted((ROOT / "generated").rglob("*")) if path.is_file()}


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ["contracts", "fast", "postgres", "process", "browser", "ui", "usage", "native", "access", "cohort", "growth"]:
        raise SystemExit("Usage: ./dev/check contracts|fast|postgres|process|browser|ui|usage|native|access|cohort|growth")
    if shutil.which("java") is None or shutil.which("sbt") is None:
        os.chdir(ROOT)
        os.execvp("nix", ["nix", "develop", "-c", str(ROOT / "dev/check"), sys.argv[1]])
    (ROOT / ".work").mkdir(exist_ok=True)
    identifier = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S") + "-" + sys.argv[1]
    evidence = Path(os.environ.get("CQ_EVIDENCE_ROOT", str(ROOT / ".work/evidence"))) / identifier
    evidence.mkdir(parents=True)
    print(f"Evidence: {evidence}", flush=True)
    checks = Checks(evidence, dict(os.environ))
    command = sys.argv[1]
    files = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=ROOT).decode().split("\0")
    source = {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest() for name in sorted(set(files)) if name and (ROOT / name).is_file()}
    (evidence / "source-sha256.json").write_text(json.dumps(source, indent=2) + "\n")
    summary = {"check": command, "baseline": subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=ROOT).decode().strip(),
               "status": "running", "sourceManifest": "source-sha256.json"}
    result_file = evidence / "result.json"
    result_file.write_text(json.dumps(summary, indent=2) + "\n")
    try:
        if command == "fast":
            checks.generate()
            checks.run(["node", "--test", "dev/pi-bridge-check.mjs"], "pi-bridge", STARTUP_TIMEOUT)
            checks.run(["node", "dev/pi-attached-check.mjs"], "pi-attached", STARTUP_TIMEOUT)
            checks.run(["node", "--test", "--test-force-exit", "dev/pi-driver-check.mjs"], "pi-driver", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/consumer-evidence-check.py"], "consumer-evidence", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/consumer-cohort-check.py"], "consumer-cohort", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/process-evidence-check.py"], "process-evidence", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/process-assess-check.py"], "process-assess-evidence", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/process-reopening-check.py"], "process-reopening-evidence", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/defect-evidence-check.py"], "defect-evidence", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/defect-probe-check.py"], "defect-probe", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/defect-plan-check.py"], "defect-plan", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/defect-integrate-check.py"], "defect-integrate", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/defect-upstream-check.py"], "defect-upstream", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/defect-assess-check.py"], "defect-assess", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/evaluate-check.py"], "evaluation-suite", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/release-check.py"], "release-provenance", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/release-evaluate-check.py"], "release-scheduling", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/release-report-check.py"], "release-accounting", STARTUP_TIMEOUT)
            checks.run(["python3", "dev/release-metrics-check.py"], "release-metrics", STARTUP_TIMEOUT)
            checks.sbt(["server/testOnly *Dummy *Local"], "dummy-contract")
        else:
            getattr(checks, command)()
    except BaseException as failure:
        summary.update(status="failed", error=str(failure))
        result_file.write_text(json.dumps(summary, indent=2) + "\n")
        raise
    summary["status"] = "passed"
    result_file.write_text(json.dumps(summary, indent=2) + "\n")
    print(f"PASS: {command}; evidence {evidence}", flush=True)


if __name__ == "__main__":
    main()
