model cq.api
version "0.1.0"

root id ProjectId { value: uid }
root id Revision { value: i64 }

root data Probe {
  project: ProjectId
  revision: Revision
  text: str
}

root adt ApiError {
  data InvalidInput { message: str }
  data Unauthorized { message: str }
  data Conflict { expected: Revision actual: Revision }
  data UnsupportedVersion { requested: str supported: lst[str] }
}

root data ProtocolHello {
  version: str
  supported: lst[str]
}

enum Ledger { Milestones Ideas Defects Goals Tasks Researches Hypothesis Questions Decisions Reviews Handoffs OperatorActions Memories Upstream }
root data ItemId { project: ProjectId ledger: Ledger number: i64 }
root id SessionId { value: uid }
root id RequestId { value: uid }
root id ClaimId { value: uid }
root id AttemptId { value: uid }
root id AssignmentId { value: uid }
root id ObservationId { value: uid }
root id ArtifactId { value: uid }
root id ChangeCursor { value: i64 }
enum Role { Human Governor Explorer Planner Worker Reviewer Collector }
root data Actor { subject: str session: SessionId role: Role }
root data Provenance { actor: Actor receivedAt: i64 request: RequestId }
root data Project { id: ProjectId name: str revision: Revision createdAt: i64 }

enum MilestoneStatus { Open Complete Cancelled }
enum IdeaStatus { Proposed Accepted Declined Withdrawn }
enum DefectStatus { Open Resolved NotReproducible Rejected Withdrawn }
enum GoalStatus { Open Achieved Abandoned }
enum TaskStatus { Ready Active Done Cancelled }
enum ResearchStatus { Open Active Concluded Inconclusive Cancelled }
enum HypothesisStatus { Proposed Investigating Supported Refuted Inconclusive Withdrawn }
enum QuestionStatus { Open Answered Withdrawn }
enum DecisionStatus { Proposed Adopted Superseded Withdrawn }
enum ReviewStatus { Pending Active Approved ChangesRequested Cancelled }
enum HandoffStatus { Open Accepted Cancelled }
enum OperatorActionStatus { Requested Confirmed Observed Failed Cancelled }
enum MemoryStatus { Current Superseded Retracted }
enum UpstreamStatus { Identified Reported Resolved Declined Withdrawn }
enum Severity { Low Medium High Critical }
enum EvidenceOrigin { ModelDeclared HostObserved HumanReported }
root adt Citation {
  data Url { address: str }
  data Artifact { id: ArtifactId }
  data Commit { repository: str hash: str }
  data File { path: str revision: opt[str] }
}
root data Evidence { description: str origin: EvidenceOrigin citations: lst[Citation] }
root data ReviewedItem { item: ItemId revision: Revision }
root adt Content {
  data Milestone { status: MilestoneStatus objective: str }
  data Idea { status: IdeaStatus outcome: str motivation: str }
  data Defect { status: DefectStatus severity: Severity observed: str expected: str reproduction: str cause: opt[str] resolution: lst[Evidence] }
  data Goal { status: GoalStatus outcome: str acceptance: lst[str] scope: str }
  data Task { status: TaskStatus acceptance: lst[str] result: opt[str] validation: lst[Evidence] }
  data Research { status: ResearchStatus question: str findings: lst[Evidence] conclusion: opt[str] recommendation: opt[str] }
  data Hypothesis { status: HypothesisStatus claim: str rationale: str evidence: lst[Evidence] adjudication: opt[str] }
  data Question { status: QuestionStatus prompt: str context: str alternatives: lst[str] answer: opt[str] }
  data Decision { status: DecisionStatus choice: str rationale: str alternatives: lst[str] }
  data Review { status: ReviewStatus subjects: lst[ReviewedItem] candidate: opt[Citation.Commit] findings: lst[Evidence] summary: opt[str] }
  data Handoff { status: HandoffStatus outcome: str remaining: lst[str] blockers: lst[str] }
  data OperatorAction { status: OperatorActionStatus action: str expectedEvidence: str confirmation: opt[str] observedEvidence: lst[Evidence] }
  data Memory { status: MemoryStatus knowledge: str applicability: str evidence: lst[Evidence] }
  data Upstream { status: UpstreamStatus component: str version: str reproduction: str report: opt[Citation.Url] outcome: opt[str] }
}
root data ItemDraft { title: str body: str labels: set[str] archived: bit content: Content citations: lst[Citation] }
root data Item { id: ItemId revision: Revision draft: ItemDraft createdAt: i64 updatedAt: i64 provenance: Provenance }
enum Relation { DerivedFrom Produces PartOf Contains BlockedBy Blocks Reviews ReviewedBy Supports SupportedBy Contradicts ContradictedBy Supersedes SupersededBy RelatesTo }
root data ItemRef { relation: Relation target: ItemId }
root data ItemView { item: Item refs: lst[ItemRef] }
root data HistoryEntry { item: ItemView cursor: ChangeCursor reason: str schemaVersion: str }
root data Fence { claim: ClaimId generation: i64 }
root data ClaimSnapshot { cursor: ChangeCursor digest: str }
root adt ClaimOrigin {
  data Acquire { durationMillis: i64 }
  data Takeover { actor: Actor snapshot: ClaimSnapshot durationMillis: i64 }
}
root data Claim { fence: Fence owner: Actor members: set[ItemId] expiresAt: i64 released: bit origin: ClaimOrigin }
root data ClaimPreview { members: lst[ItemRevision] claims: lst[Claim] integrations: lst[IntegrationHold] snapshot: ClaimSnapshot }
enum TerminationIntent { Cancel Complete }
root adt TerminalStatus {
  data Milestone { value: MilestoneStatus }
  data Idea { value: IdeaStatus }
  data Defect { value: DefectStatus }
  data Goal { value: GoalStatus }
  data Task { value: TaskStatus }
  data Research { value: ResearchStatus }
  data Hypothesis { value: HypothesisStatus }
  data Question { value: QuestionStatus }
  data Decision { value: DecisionStatus }
  data Review { value: ReviewStatus }
  data Handoff { value: HandoffStatus }
  data OperatorAction { value: OperatorActionStatus }
  data Memory { value: MemoryStatus }
  data Upstream { value: UpstreamStatus }
}
root adt TerminationExclusion {
  data Context { source: ItemId relation: Relation }
  data Shared { producer: ItemId }
  data Prerequisite { consumer: ItemId }
  data ExcludedBranch {}
}
root adt TerminationEffect {
  data Change { status: TerminalStatus }
  data Preserve {}
  data Excluded { reasons: lst[TerminationExclusion] }
  data Unsupported { message: str }
}
root data TerminationEntry { item: ItemSummary effect: TerminationEffect }
root data TerminationClaim { fence: Fence owner: Actor members: lst[ItemId] affected: lst[ItemId] permitted: bit }
root data TerminationPlan { roots: lst[ItemId] intent: TerminationIntent entries: lst[TerminationEntry] claims: lst[TerminationClaim] integrations: lst[IntegrationHold] canApply: bit }
root data TerminationSnapshot { cursor: ChangeCursor digest: str }
root data TerminationPreview { plan: TerminationPlan snapshot: TerminationSnapshot }
root adt Mutation {
  data Produce { producer: ItemId expected: Revision drafts: lst[ItemDraft] }
  data Terminate { roots: set[ItemId] intent: TerminationIntent snapshot: TerminationSnapshot }
  data Create { draft: ItemDraft }
  data Replace { id: ItemId expected: Revision draft: ItemDraft }
  data Reference { source: ItemId expectedSource: Revision relation: Relation target: ItemId expectedTarget: Revision present: bit }
  data Restore { id: ItemId expected: Revision historical: Revision neighbors: lst[ItemRevision] }
}
root data BrowserDraft { project: ProjectId item: opt[ItemRevision] value: ItemDraft pending: opt[ChangeRequest] }
root data ChangeRequest { request: RequestId mutations: lst[Mutation] fences: lst[Fence] reason: str }
root data ItemRevision { id: ItemId revision: Revision }
root data ChangeAck { request: RequestId cursor: ChangeCursor items: lst[ItemRevision] }
root data ChangeEvent { cursor: ChangeCursor request: RequestId items: lst[ItemRevision] }
root data ChangePage { cursor: ChangeCursor events: lst[ChangeEvent] hasMore: bit }
enum ArchiveFilter { Active Archived All }
root data QuerySpan { start: i32 end: i32 }
root data QueryDiagnostic { span: QuerySpan message: str }
root data QueryItem { ledger: Ledger number: i64 }
enum QuerySuggestionKind { Field Relation Operator Value Item }
root data QuerySuggestion { kind: QuerySuggestionKind span: QuerySpan text: str label: str }
root data QueryAnalysis { diagnostic: opt[QueryDiagnostic] suggestions: lst[QuerySuggestion] hasMore: bit }
root adt QueryExpression {
  data All {}
  data Text { words: lst[str] phrase: bit }
  data Id { item: QueryItem }
  data LedgerIs { ledger: Ledger }
  data Status { value: str }
  data Tag { value: str }
  data Project { id: ProjectId }
  data Archive { value: ArchiveFilter }
  data Reference { relation: Relation item: QueryItem }
  data Not { expression: QueryExpression }
  data And { left: QueryExpression right: QueryExpression }
  data Or { left: QueryExpression right: QueryExpression }
}
root data ItemOutcome { terminal: bit satisfiesDependency: bit }
root data ItemSummary { id: ItemId revision: Revision title: str status: str archived: bit labels: set[str] updatedAt: i64 outcome: ItemOutcome }
root data ItemPage { items: lst[ItemSummary] cursor: ChangeCursor after: opt[ItemId] hasMore: bit }
enum WorksetRole { Selected Context }
root adt WorksetReason {
  data Archived {}
  data Terminal {}
  data Blocked { prerequisite: ItemId }
  data Shared { producer: ItemId }
  data Context { source: ItemId relation: Relation }
}
root data WorksetEntry { item: ItemSummary role: WorksetRole root: bit ready: bit reasons: lst[WorksetReason] }
root data WorksetSnapshot { cursor: ChangeCursor rootsHash: str }
root data WorksetPage { entries: lst[WorksetEntry] snapshot: WorksetSnapshot after: opt[ItemId] hasMore: bit selectedCount: i32 contextCount: i32 readyCount: i32 }
root data HistoryPage { entries: lst[HistoryEntry] hasMore: bit }
root adt Fault {
  data IntegrationPending { id: IntegrationId }
  data Invalid { message: str }
  data QuerySyntax { diagnostic: QueryDiagnostic }
  data Denied { message: str }
  data Missing { message: str }
  data Conflict { message: str }
  data StaleFence { message: str }
  data Resync { message: str }
  data Limit { message: str }
}

enum Harness { Claude Codex Pi }
enum AttemptState { Running Completed Failed Cancelled Unknown }
enum Attribution { Direct Shared Unattributed }
root data EvaluationScope { run: str scenario: str assessor: bit }
root data Assignment { id: AssignmentId project: ProjectId members: set[ItemId] attribution: Attribution cohort: opt[uid] evaluation: opt[EvaluationScope] }
root data Attempt { id: AttemptId assignment: AssignmentId parent: opt[AttemptId] session: SessionId role: Role harness: Harness provider: str model: str collector: str startedAt: i64 }
enum CounterScope { Increment Cumulative }
enum Measurement { Observed Estimated Missing Unsupported }
root data Counter { value: opt[i64] measurement: Measurement }
root data TokenCounts { input: Counter output: Counter cacheRead: Counter cacheWrite: Counter reasoning: Counter }
enum CostBasis { ProviderEstimate PriceTable ActualBilling Unknown }
root id DecimalAmount { value: str }
root data Money { amount: opt[DecimalAmount] currency: opt[str] basis: CostBasis pricingVersion: opt[str] }
enum UsageCompleteness { Partial Complete Unavailable }
root data UsageObservation {
  id: ObservationId
  attempt: AttemptId
  source: str
  position: i64
  occurredAt: i64
  receivedAt: i64
  scope: CounterScope
  counters: TokenCounts
  inputIncludesCache: bit
  outputIncludesReasoning: bit
  cost: Money
  completeness: UsageCompleteness
  gaps: lst[str]
  evidence: opt[ArtifactId]
  supersedes: opt[ObservationId]
}

root data UsageMeter { key: str attempt: AttemptId scope: CounterScope baseline: TokenCounts baselineCost: Money }
enum UsageDisposition { Contribution Detail }
root data UsageUpload { observation: UsageObservation meter: str disposition: UsageDisposition detailReason: opt[str] }
root data UsageReceipt { id: ObservationId sequence: i64 }
root data RecordedUsage { upload: UsageUpload normalized: TokenCounts actor: Actor sequence: i64 }
root data AttemptOutcome { request: RequestId attempt: AttemptId state: AttemptState finishedAt: i64 gaps: lst[str] supersedes: opt[RequestId] }
root data RecordedOutcome { value: AttemptOutcome actor: Actor receivedAt: i64 sequence: i64 }
root data AttemptCoverage { running: i64 unknown: i64 withGaps: i64 }
root data AttemptView { assignment: Assignment attempt: Attempt outcome: opt[RecordedOutcome] }
root data AttemptPage { entries: lst[AttemptView] after: opt[AttemptId] hasMore: bit cursor: i64 }
root data OutcomePage { entries: lst[RecordedOutcome] after: i64 hasMore: bit cursor: i64 }
root data MetricTotal { known: i64 unknown: i64 estimated: i64 }
root data CostGroup { attribution: Attribution currency: str basis: CostBasis pricingVersion: opt[str] }
root data CostTotal { group: CostGroup amount: DecimalAmount measurements: i64 }
root data CostPage { entries: lst[CostTotal] after: opt[CostGroup] hasMore: bit cursor: i64 }
root data UsageTotals {
  input: MetricTotal
  output: MetricTotal
  cacheRead: MetricTotal
  cacheWrite: MetricTotal
  reasoning: MetricTotal
  total: MetricTotal
  unknownCosts: i64
}
root data MeterProjection { totals: UsageTotals latestPosition: opt[i64] incompleteSamples: i64 completeness: UsageCompleteness gaps: lst[str] }
root data MeterView { assignment: Assignment attempt: Attempt meter: UsageMeter projection: MeterProjection }
root adt UsageFilter {
  data ProjectAll {}
  data TaskOnly { item: ItemId }
  data CohortOnly { execution: uid }
  data SessionOnly { id: SessionId }
  data EvaluationOnly { run: str scenario: opt[str] }
}
root data UsageReport {
  direct: UsageTotals
  shared: UsageTotals
  unattributed: UsageTotals
  sharedAssignments: set[AssignmentId]
  sharedAssignmentsTruncated: bit
  cursor: i64
  incompleteMeters: i64
  attemptsWithoutMeters: i64
  attempts: AttemptCoverage
  costs: CostPage
}
root data UsagePage { entries: lst[RecordedUsage] after: i64 hasMore: bit cursor: i64 }

root data ProjectPage { projects: lst[Project] after: opt[ProjectId] hasMore: bit }
root data ProjectConfig { project: ProjectId endpoint: str name: str }
root data SearchInput { project: ProjectId query: str after: opt[ItemId] snapshot: opt[ChangeCursor] limit: i32 }
root data GraphInput { project: ProjectId roots: set[ItemId] after: opt[ItemId] snapshot: opt[WorksetSnapshot] limit: i32 }
root adt ReadSelection {
  data Proposal { id: ArtifactId }
  data Integration { id: IntegrationId }
  data Admission { attempt: AttemptId }
  data Claims { members: set[ItemId] }
  data Termination { roots: set[ItemId] intent: TerminationIntent }
  data QueryComplete { query: str cursor: i32 limit: i32 }
  data ArtifactInfo { id: ArtifactId }
  data ArtifactText { id: ArtifactId offset: i32 limit: i32 }
  data ItemDetail { id: ItemId }
  data History { id: ItemId before: Revision limit: i32 }
  data Changes { after: ChangeCursor limit: i32 }
}
root data ReadInput { project: ProjectId selection: ReadSelection }
root data ChangeInput { project: ProjectId change: ChangeRequest }
root data ProposalApplyInput { project: ProjectId result: ArtifactId }
root adt ClaimAction {
  data Takeover { id: ClaimId owner: Actor members: set[ItemId] durationMillis: i64 snapshot: ClaimSnapshot }
  data Acquire { id: ClaimId members: set[ItemId] durationMillis: i64 }
  data Renew { fence: Fence durationMillis: i64 }
  data Release { fence: Fence }
}
root data ClaimInput { project: ProjectId action: ClaimAction }
root adt UsageSelection {
  data Summary { filter: UsageFilter }
  data Costs { filter: UsageFilter after: opt[CostGroup] snapshot: opt[i64] limit: i32 }
  data Audit { filter: UsageFilter after: i64 limit: i32 }
  data Attempts { filter: UsageFilter after: opt[AttemptId] snapshot: opt[i64] limit: i32 }
  data Outcomes { attempt: AttemptId after: i64 limit: i32 }
}
root data UsageInput { project: ProjectId selection: UsageSelection }
root adt Command {
  data Projects { after: opt[ProjectId] limit: i32 }
  data Initialize { config: ProjectConfig }
  data RenameProject { project: ProjectId expected: Revision name: str }
  data Search { input: SearchInput }
  data Graph { input: GraphInput }
  data Read { input: ReadInput }
  data Change { input: ChangeInput }
  data ApplyProposal { input: ProposalApplyInput }
  data ClaimWork { input: ClaimInput }
  data Usage { input: UsageInput }
}
root adt Result {
  data Proposal { preview: ProposalPreview }
  data Integration { record: IntegrationRecord }
  data Admission { record: ResultAdmission }
  data Claims { preview: ClaimPreview }
  data Termination { preview: TerminationPreview }
  data Workset { page: WorksetPage }
  data QueryAnalyzed { analysis: QueryAnalysis }
  data ArtifactInfo { metadata: ArtifactMetadata }
  data ArtifactText { page: ArtifactPage }
  data Projects { page: ProjectPage }
  data Initialized { project: Project }
  data Found { page: ItemPage }
  data Detail { view: ItemView }
  data History { page: HistoryPage }
  data Changes { page: ChangePage }
  data Changed { ack: ChangeAck }
  data Claimed { claim: Claim }
  data UsageSummary { report: UsageReport }
  data UsageCosts { page: CostPage }
  data UsageAudit { page: UsagePage }
  data UsageAttempts { page: AttemptPage }
  data UsageOutcomes { page: OutcomePage }
  data Failed { fault: Fault }
}
root adt HostUsage {
  data Assign { value: Assignment }
  data Start { value: Attempt }
  data Meter { value: UsageMeter }
  data Ingest { value: UsageUpload }
  data Finish { value: AttemptOutcome }
}
root data HostUsageInput { project: ProjectId operation: HostUsage }
root adt HostUsageResult {
  data Assigned { value: Assignment }
  data Started { value: Attempt }
  data Metered { value: UsageMeter }
  data Ingested { value: UsageReceipt }
  data Finished { value: AttemptOutcome }
}
root data GrantRequest { project: ProjectId actor: Actor expiresAt: i64 }
root adt Credential {
  data RootSession { session: SessionId expiresAt: i64 }
  data Scoped { grant: GrantRequest }
}
root data AccessToken { value: str expiresAt: i64 }
root adt ClientFrame {
  data Call { id: RequestId command: Command }
  data Subscribe { id: RequestId project: ProjectId after: ChangeCursor }
  data Ping { nonce: str }
  data Pong { nonce: str }
}
root adt ServerFrame {
  data Reply { id: RequestId result: Result }
  data Changes { subscription: RequestId project: ProjectId page: ChangePage }
  data Resync { subscription: RequestId project: ProjectId fault: Fault }
  data Ping { nonce: str }
  data Pong { nonce: str }
}

root id GitCommit { value: str }
root data WorkspaceSpec { project: ProjectId owner: SessionId attempt: AttemptId repository: str base: GitCommit }
enum WorkspaceAdmission { Open Quarantined }
root data WorkspaceObservation { head: GitCommit gitCommon: str gitDirectory: str verifiedAt: i64 }
root data WorkspaceRecord { spec: WorkspaceSpec directory: str admission: WorkspaceAdmission observed: opt[WorkspaceObservation] quarantineReason: opt[str] }

enum ArtifactKind { Prompt Input Result Transcript Validation Combination }
root data ArtifactUpload { project: ProjectId id: ArtifactId attempt: AttemptId kind: ArtifactKind mediaType: str body: str }
root data ArtifactMetadata { project: ProjectId id: ArtifactId attempt: AttemptId kind: ArtifactKind mediaType: str sha256: str bytes: i32 codePoints: i32 actor: Actor receivedAt: i64 }
root data ArtifactPage { metadata: ArtifactMetadata offset: i32 next: i32 hasMore: bit text: str }

enum StopReason { Exited Cancelled OwnerExited InvalidControl LaunchFailed OutputLimit HostFailure StartupDeadline ExecutionDeadline HeartbeatLost Signalled }
enum JobTarget { Run Stop }
enum JobPhase { Preparing Starting Running Stopping Settled Uncertain }
root data JobExit { code: opt[i32] signal: opt[i32] reason: StopReason stdoutBytes: i64 stderrBytes: i64 settled: bit hostFailure: bit }
root data JobRecord {
  workspace: WorkspaceSpec fingerprint: str target: JobTarget phase: JobPhase
  exit: opt[JobExit] problem: opt[str] revision: i64 createdAt: i64 updatedAt: i64
}

root data HarnessSetting {
  harness: Harness executable: str model: str provider: str version: str
  providerExtensions: lst[str] providerEnvironment: set[str]
}
root data HostLimits { startupMillis: i64 executionMillis: i64 heartbeatMillis: i64 graceMillis: i64 killMillis: i64 outputBytes: i32 }
root data ValidationCheck { name: str command: lst[str] executionMillis: i64 outputBytes: i32 }
root data SupervisorSettings { stateRoot: str guardian: str harnesses: lst[HarnessSetting] limits: HostLimits checks: lst[ValidationCheck] evaluation: opt[EvaluationScope] integrationTarget: opt[str] }
root data GoverningReport { summary: str }
root data HarnessRoute { harness: Harness model: str provider: str }
enum WorkflowPhase { Explore Plan Work Review Integrate }
enum UpstreamAction { Prepare Report Recheck }
root adt WorkflowRequest {
  data Begin { roots: set[ItemId] }
  data Advance { roots: set[ItemId] through: WorkflowPhase }
  data Review { result: ArtifactId mode: ReviewerMode }
  data Upstream { roots: set[ItemId] action: UpstreamAction }
}
root data WorkflowSubject { result: ArtifactId work: DispatchWork members: lst[ItemRevision] candidate: opt[GitCommit] }
root data WorkflowContext { request: WorkflowRequest instructions: str subject: opt[WorkflowSubject] }
root data GoverningInput { project: ProjectConfig routes: lst[HarnessRoute] checks: lst[str] limits: HostLimits integrationTarget: opt[str] request: str workflow: opt[WorkflowContext] }
root data NativeManifest { encoding: str mediaType: str bytes: i64 sha256: str parts: lst[ArtifactId] }
root adt HostDelivery {
  data Usage { value: HostUsageInput }
  data Artifact { value: ArtifactUpload }
}
root data DeliveryBatch { entries: lst[HostDelivery] }
root data SupervisorRun {
  project: ProjectConfig assignment: Assignment attempt: Attempt harnessVersion: str
  repository: str base: GitCommit
}
root data SupervisorReceipt {
  session: SessionId attempt: AttemptId directory: str phase: JobPhase
  processSucceeded: bit result: opt[ArtifactId] report: opt[GoverningReport] usageDelivered: bit problem: opt[str]
}

enum WorkerMode { Implement Probe ResolveConflict }
enum ExplorerMode { Investigate Research }
enum ReviewerMode { Candidate Plan Audit }
root adt DispatchWork {
  data Explorer { mode: ExplorerMode }
  data Planner {}
  data Worker { mode: WorkerMode }
  data Reviewer { mode: ReviewerMode }
}
root data DispatchRequest {
  request: RequestId work: DispatchWork harness: Harness members: lst[ItemRevision]
  guidance: lst[ItemRevision] artifacts: lst[ArtifactId] previous: opt[ArtifactId]
  fence: Fence limits: HostLimits
}
enum WorkDisposition { CandidateReady Blocked Failed }
enum ReviewVerdict { Accepted ChangesRequested Blocked }
enum PlanDisposition { Proposed Blocked Abstained }
enum EvidenceDisposition { Findings Inconclusive Blocked Failed }
root data WorkMember { item: ItemId disposition: WorkDisposition summary: str }
root data ReviewMember { item: ItemId verdict: ReviewVerdict findings: lst[str] }
root data PlanMember { item: ItemId disposition: PlanDisposition summary: str }
root data EvidenceMember {
  item: ItemId disposition: EvidenceDisposition summary: str evidence: lst[Evidence]
  uncertainties: lst[str] requestedProbes: lst[str]
}
root adt ProposedMutation {
  data Create { draft: ItemDraft }
  data Replace { id: ItemId draft: ItemDraft }
  data Produce { producer: ItemId drafts: lst[ItemDraft] }
  data Reference { source: ItemId relation: Relation target: ItemId present: bit }
}
root data LedgerProposal { mutations: lst[ProposedMutation] reason: str }
root data ProposalDraftSummary { ledger: Ledger title: str status: TerminalStatus archived: bit }
root data ProposalFieldChanges {
  body: bit labels: bit content: bit citations: bit evidence: bit provenance: bit operatorConfirmation: bit
}
root adt ProposalOperationSummary {
  data Create { draft: ProposalDraftSummary }
  data Replace { id: ItemId before: ProposalDraftSummary after: ProposalDraftSummary fields: ProposalFieldChanges }
  data Produce { producer: ItemId drafts: lst[ProposalDraftSummary] }
  data Reference { source: ItemId relation: Relation target: ItemId present: bit }
}
root data ProposalPreview {
  result: ArtifactId request: RequestId role: Role members: lst[ItemRevision]
  operations: lst[ProposalOperationSummary] detailsOmitted: bit
}
root adt ChildReport {
  data Evidence { members: lst[EvidenceMember] }
  data Plan { members: lst[PlanMember] proposal: opt[LedgerProposal] }
  data Work { members: lst[WorkMember] }
  data Review { members: lst[ReviewMember] proposal: opt[LedgerProposal] }
}
root data ChildResult {
  attempt: AttemptId request: DispatchRequest base: GitCommit candidate: opt[GitCommit] report: ChildReport validation: lst[ValidationEvidence]
}
root data ChildPublication {
  project: ProjectId owner: Actor result: opt[ChildResult] status: DispatchStatus outcome: AttemptOutcome
}
enum AdmissionRejection { ClaimLost RevisionsChanged }
root adt AdmissionDecision {
  data Accepted {}
  data Rejected { reason: AdmissionRejection }
}
root data HostAdmissionInput { project: ProjectId artifact: ArtifactId owner: Actor }
root data ResultAdmission {
  artifact: ArtifactMetadata owner: Actor fence: Fence members: lst[ItemRevision] decision: AdmissionDecision decidedAt: i64
}
root id IntegrationId { value: uid }
root data IntegrationIntent {
  id: IntegrationId project: ProjectId owner: Actor repository: str target: str expected: GitCommit candidate: GitCommit
  worker: ArtifactId reviewer: ArtifactId checks: lst[ValidationCheck] fence: Fence members: lst[ItemRevision] change: ChangeRequest
}
root data IntegrationHold {
  id: IntegrationId owner: Actor target: str expected: GitCommit candidate: GitCommit members: lst[ItemRevision]
}
root adt IntegrationObservation {
  data Incorporated { target: GitCommit }
  data NotApplied { reason: str }
}
root adt IntegrationResolution {
  data Pending {}
  data NotApplied { reason: str }
  data Recorded { acknowledgement: ChangeAck observedTarget: GitCommit }
}
root data IntegrationRecord { intent: IntegrationIntent resolution: IntegrationResolution reservedAt: i64 resolvedAt: opt[i64] }
root data IntegrationTicket { id: IntegrationId reviewer: ArtifactId }
root data IntegrationPreview {
  id: IntegrationId reviewer: ArtifactId target: str expected: GitCommit candidate: GitCommit members: lst[ItemRevision]
}
enum IntegrationPhase { Preparing Ready Running Pending Recorded NotApplied Failed }
enum IntegrationNext { Wait Confirm Reconcile InspectEvidence Complete }
root data IntegrationStatus { id: IntegrationId phase: IntegrationPhase preview: opt[IntegrationPreview] next: IntegrationNext blocker: opt[str] }
root data IntegrationLocal { intent: IntegrationIntent attempted: bit observation: opt[IntegrationObservation] }
root data CombinationTicket { id: RequestId source: IntegrationId fence: Fence }
root data CombinationPlan {
  request: CombinationTicket project: ProjectId owner: Actor governor: AttemptId repository: str target: str
  observedTarget: GitCommit candidate: GitCommit worker: ArtifactId members: lst[ItemRevision]
}
root data CombinationPreview { plan: ArtifactId worker: ArtifactId members: lst[ItemRevision] fence: Fence target: GitCommit }
enum CombinationPhase { Preparing Ready PublicationPending Failed }
root data CombinationStatus { id: RequestId phase: CombinationPhase preview: opt[CombinationPreview] blocker: opt[str] }
root adt HostIntegration {
  data Reserve { intent: IntegrationIntent }
  data Observe { id: IntegrationId observation: IntegrationObservation }
}
root data HostIntegrationInput { project: ProjectId operation: HostIntegration }
root data ResolvedArtifact { metadata: ArtifactMetadata body: str }
root data ChildInput {
  project: ProjectId request: DispatchRequest members: lst[ItemView] guidance: lst[ItemView]
  artifacts: lst[ResolvedArtifact] previous: opt[ChildResult]
}
root data ChildExecutionInput { input: ChildInput base: GitCommit checks: lst[ValidationCheck] }
enum ValidationState { Passed Failed Unknown }
root data ValidationEvidence { check: str state: ValidationState artifact: ArtifactId }
root data ValidationObservation { check: ValidationCheck candidate: GitCommit job: JobRecord stdout: ArtifactId stderr: ArtifactId }
enum DeclaredCheckPhase { Starting Running Publishing Completed Failed Unknown }
root data DeclaredCheckTicket { parent: AttemptId check: ValidationCheck workspace: WorkspaceSpec fingerprint: str }
root data DeclaredCheckStatus { name: str job: AttemptId phase: DeclaredCheckPhase evidence: opt[ValidationEvidence] blocker: opt[str] }
enum DispatchPhase { Preparing Running Stopping Validating Publishing Completed Failed Cancelled Unknown PublicationPending }
enum ChildNext { Wait Plan Review Revise ResolveBlocker Retry ConsiderAcceptance ConsiderProposal InspectEvidence RetryDelivery }
root data ChildCounts {
  ready: i32 accepted: i32 changesRequested: i32 blocked: i32 failed: i32 validationFailed: i32 validationUnknown: i32
  proposed: i32 evidence: i32 abstained: i32
}
root data DispatchStatus {
  request: RequestId attempt: AttemptId phase: DispatchPhase process: opt[JobPhase] members: lst[ItemId]
  counts: ChildCounts next: ChildNext blocker: opt[str] result: opt[ArtifactId] detailsOmitted: bit usageDelivered: bit
}
root data DispatchTicket { request: DispatchRequest assignment: Assignment attempt: Attempt profile: HarnessSetting }
root adt DispatchCommand {
  data Start { request: DispatchRequest }
  data Status { attempt: AttemptId waitMillis: i32 }
  data Cancel { attempt: AttemptId }
  data PrepareIntegration { id: IntegrationId reviewer: ArtifactId }
  data Integrate { id: IntegrationId }
  data IntegrationStatus { id: IntegrationId waitMillis: i32 }
  data Combine { id: RequestId source: IntegrationId fence: Fence }
  data CombinationStatus { id: RequestId waitMillis: i32 }
}
root adt DispatchReply {
  data Status { value: DispatchStatus }
  data Integration { value: IntegrationStatus }
  data Combination { value: CombinationStatus }
  data Failed { fault: Fault }
}
root adt WorkspaceCommand {
  data Entries { path: str after: opt[str] limit: i32 }
  data Read { path: str offset: i32 limit: i32 }
  data MergeReport { offset: i32 limit: i32 }
  data Check { name: str waitMillis: i32 }
}
enum WorkspaceEntryKind { File Directory Symlink }
root data WorkspaceEntry { name: str kind: WorkspaceEntryKind }
root data WorkspacePage { entries: lst[WorkspaceEntry] after: opt[str] hasMore: bit }
root data WorkspaceText { path: str offset: i32 next: i32 hasMore: bit text: str }
root adt WorkspaceReply {
  data Listed { page: WorkspacePage }
  data Text { page: WorkspaceText }
  data Check { value: DeclaredCheckStatus }
  data Failed { fault: Fault }
}
