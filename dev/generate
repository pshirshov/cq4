#!/usr/bin/env python3
import os
from pathlib import Path
import shutil
import subprocess
from schema import generate_schemas


ROOT = Path(__file__).resolve().parent.parent
VERSION = "0.0.196"


def replace_once(path, before, after):
    content = path.read_text()
    if content.count(before) != 1:
        raise RuntimeError(f"Baboon compatibility patch no longer matches {path}")
    path.write_text(content.replace(before, after))


def scala3_runtime():
    runtime = ROOT / "generated" / "scala"
    tools = runtime / "BaboonTools.scala"
    for body, condition in [
        ("""        byteRead = input.readByte() & 0xFF // Read unsigned byte
        length |= (byteRead & 0x7F) << shift
        shift += 7""", "(byteRead & 0x80) != 0"),
        ("""        var currentByte = (value & 0x7F).toByte
        value >>>= 7
        if (value != 0) currentByte = (currentByte | 0x80).toByte
        output.writeByte(currentByte.toInt)""", "value != 0"),
    ]:
        replace_once(tools, f"      do {{\n{body}\n      }} while ({condition})",
                     f"      while ({{\n{body}\n        {condition}\n      }}) ()")
    replace_once(runtime / "BaboonCodecsFacade.scala", "convert(value).toOption",
                 "convert[TI, TO](value).toOption")
    replace_once(runtime / "BaboonCodecsFacade.scala",
                 "def tryConvert[TI <: BaboonGenerated, TO <: BaboonGeneratedLatest]",
                 "def tryConvert[TI <: BaboonGenerated, TO <: BaboonGeneratedLatest: ClassTag]")


def main():
    compiler = os.environ.get("CQ_BABOON")
    if compiler is None:
        os.execvp("nix", ["nix", "develop", str(ROOT), "-c", str(ROOT / "dev/generate")])
    binary = Path(compiler)
    banner = subprocess.run([str(binary), "--help"], check=True, stdout=subprocess.PIPE, text=True).stdout
    if not banner.startswith(f"Baboon {VERSION} @ "):
        raise RuntimeError(f"Expected Baboon {VERSION}; compiler reported {banner[:200]!r}")
    print(f"Compiler: {binary}\n{banner.splitlines()[0]}", flush=True)
    models = list((ROOT / "models").glob("*.baboon"))
    if models != [ROOT / "models/cq-api.baboon"]:
        raise RuntimeError("Keep one CQ model; version bumps require explicit user instruction")
    if models[0].read_text().splitlines()[:2] != ["model cq.api", 'version "0.1.0"']:
        raise RuntimeError("Keep cq.api at 0.1.0 until the user explicitly requests a version bump")
    generated = ROOT / "generated"
    if generated.exists():
        shutil.rmtree(generated)
    subprocess.run([
        str(binary), "--model-dir", "models", "--lockfile", "models/baboon.lock",
        "--lockfile-update", "force", "--lockfile-enforcement", "none",
        ":scala", "--output", "generated/scala",
        "--generate-json-codecs-by-default=true", "--generate-ueba-codecs-by-default=true",
        ":typescript", "--output", "generated/typescript", "--ts-import-suffix", ".js",
        "--generate-json-codecs-by-default=true", "--generate-ueba-codecs-by-default=true",
        ":openapi", "--output", "generated/openapi",
    ], cwd=ROOT, check=True)
    scala3_runtime()
    generate_schemas(ROOT)


if __name__ == "__main__":
    main()
