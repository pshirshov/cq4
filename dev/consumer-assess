#!/usr/bin/env python3
"""Independent native assessment of a retained consumer candidate, using CQ's audit."""
import datetime
from fractions import Fraction
import hashlib
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import time
import urllib.parse
import uuid


ROOT = Path(__file__).resolve().parent.parent


def main():
    correcting = len(sys.argv) == 3 and sys.argv[1] == "--correct"
    assert len(sys.argv) == 2 or correcting, "Usage: ./dev/consumer-assess [--correct] EVIDENCE_DIRECTORY (runs real models)"
    supplied = Path(sys.argv[-1]).resolve()
    os.chdir(ROOT)
    if any(shutil.which(name) is None for name in ["java", "sbt", "go"]):
        os.execvp("nix", ["nix", "develop", "-c", str(ROOT / "dev/consumer-assess"), *sys.argv[1:]])
    original = Path(json.loads((supplied / "result.json").read_text())["baselineEvidence"]) if correcting else supplied
    evaluation = runpy.run_path(str(ROOT / "dev/consumer-eval"))
    support = runpy.run_path(str(ROOT / "dev/check"))
    predicates = runpy.run_path(str(ROOT / "dev/consumer-evidence.py"))
    accepted_chain = predicates["accepted_chain"]
    write, call = evaluation["write"], evaluation["call"]
    baseline = json.loads((original / "result.json").read_text())
    assert baseline["status"] == "candidate-passed", "Assessment requires a passed retained candidate"
    settings = json.loads((original / "settings.json").read_text())
    statuses = json.loads((original / "dispatch-statuses.json").read_text())
    values = json.loads((original / "candidate-evidence.json").read_text())
    checks_by_name = {value["name"]: value for value in settings["checks"]}
    chain = accepted_chain(statuses, values, checks_by_name)
    assert chain == baseline["acceptedChain"], "Retained baseline chain changed"
    previous = chain["workerResult"]
    if correcting:
        rejected = json.loads((supplied / "dispatch-statuses.json").read_text())
        assert len(rejected) == 1 and rejected[0]["phase"] == "Completed" and rejected[0]["counts"]["changesRequested"] > 0, "Correction requires a completed changes-requested assessment"
        previous = rejected[0]["result"]
        finding = json.loads((supplied / "candidate-evidence.json").read_text())[previous["value"]]["body"]
        assert finding["candidate"] == chain["candidate"] and finding["request"]["members"] == chain["members"] and finding["request"]["previous"] == chain["workerResult"], "Correction finding is not linked to the baseline candidate"
    workers = [value for value in statuses if value["attempt"] == chain["worker"]]
    assert len(workers) == 1, "Expected one baseline worker receipt"
    baseline_runs = list((original / "sessions").glob("*/run.json"))
    assert len(baseline_runs) == 1, "Expected one retained baseline governing session"
    project = json.loads(baseline_runs[0].read_text())["project"]
    source = json.loads((original / "source-sha256.json").read_text())
    for name in (["dev/consumer-spec.md"] if correcting else ["dev/consumer-spec.md", "dev/consumer-oracle.py"]):
        assert hashlib.sha256((ROOT / name).read_bytes()).hexdigest() == source[name], "Consumer contract changed since baseline"
    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S")
    evidence = original.parent / (stamp + ("-correct-" if correcting else "-assess-") + original.name)
    evidence.mkdir(mode=0o700)
    print("Evidence:", evidence, flush=True)
    files = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"]).decode().split("\0")
    write(evidence / "source-sha256.json", {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest() for name in sorted(set(files)) if name and (ROOT / name).is_file()})
    checks = support["Checks"](evidence, dict(os.environ))
    result = {"status": "running", "baselineEvidence": str(original), "candidate": chain["candidate"],
              "restoredEvidence": str(supplied), "baselineDumpSha256": hashlib.sha256((supplied / "cq-database.dump").read_bytes()).hexdigest(),
              "implementation": subprocess.check_output(["git", "rev-parse", "HEAD"]).decode().strip(),
              "remaining": ["integration", "M2 human acceptance"], "scope": "independent candidate/specification assessment; no efficiency verdict"}
    if correcting:
        result.update({name: baseline[name] for name in ["harness", "language", "worker", "reviewer"]})
        result.update(scope="candidate correction through retained review handle; independent assessment remains required",
                      remaining=["independent evaluation assessment", "integration", "M2 human acceptance"])
    write(evidence / "result.json", result)
    try:
        checks.generate()
        command = ["java", "-cp", checks.classpath(), "cq.server.Main"]
        consumer = evidence / "consumer"
        checks.run(["git", "clone", "--quiet", "--no-hardlinks", str(original / "consumer"), str(consumer)], "consumer-clone", 30)
        checks.run(["git", "-C", str(consumer), "fetch", "--quiet", "origin", chain["candidate"]["value"]], "candidate-fetch", 30)
        settings["integrationTarget"] = None
        settings["stateRoot"] = str(evidence / "sessions")
        settings["evaluation"]["assessor"] = not correcting
        for route in settings["harnesses"]:
            if not correcting and route["harness"] == "Codex":
                route["model"] = "gpt-6-astra"
        write(evidence / "settings.json", settings)
        result["routes"] = settings["harnesses"]
        request = ("Obtain an independent assessment of this existing consumer candidate with the configured Codex/Astra reviewer. "
                   "Do not create or change tasks, launch workers, or integrate. Acquire the exact member set below for at most 300000 ms. "
                   "Dispatch one Codex Reviewer with these member revisions and previous worker result handle; use compact status only, "
                   "without reading full result bodies or composing a child prompt. After the review finishes, release the claim and report its outcome. "
                   "This assessment is separate from final human acceptance.\n" + json.dumps({"members": chain["members"], "previous": chain["workerResult"]}))
        if correcting:
            worker, reviewer = evaluation["PROFILES"][baseline["worker"]][0], evaluation["PROFILES"][baseline["reviewer"]][0]
            request = (f"Correct this retained candidate after independent assessment requested changes. Acquire the exact member set below for at most 300000 ms. "
                       f"Dispatch {worker} Worker Implement with the supplied previous REVIEW result handle: the host materializes its findings and candidate. "
                       f"After configured host checks pass, dispatch {reviewer} Reviewer using the NEW worker result handle. "
                       "Use compact status and handles only; do not read full results or compose child prompts. Do not create or edit tasks or integrate. "
                       "Release the claim after an accepted review, preserving member revisions for a separate independent assessment.\n" +
                       json.dumps({"members": chain["members"], "previous": previous}))
        (evidence / "request.txt").write_text(request)
        port = support["free_port"]()
        checks.environment.update(CQ_HOST="127.0.0.1", CQ_PORT=str(port), CQ_ORIGIN=f"http://127.0.0.1:{port}",
                                  CQ_TOKEN=uuid.uuid4().hex + uuid.uuid4().hex, CQ_SESSION=str(uuid.uuid4()))
        with evaluation["database"](checks, evidence, support["free_port"]()):
            parsed = urllib.parse.urlsplit(checks.environment["CQ_DATABASE_URL"].removeprefix("jdbc:"))
            checks.run(["pg_restore", "--exit-on-error", "--clean", "--if-exists", "--host", parsed.hostname, "--port", str(parsed.port),
                        "--username", checks.environment["CQ_DATABASE_USER"], "--dbname", parsed.path[1:], str(supplied / "cq-database.dump")], "database-restore", 60)
            with checks.server(command, "assessor-server"):
                environment = {name: value for name, value in checks.environment.items() if not name.startswith("CQ_")}
                environment["CQ_TOKEN"] = checks.environment["CQ_TOKEN"]
                with (evidence / "cq-init.log").open("w") as log:
                    subprocess.run(command + ["init", "--endpoint", checks.environment["CQ_ORIGIN"], "--project-id", project["project"]["value"], "--name", project["name"]],
                                   cwd=consumer, env=environment, stdout=log, stderr=subprocess.STDOUT, timeout=30, check=True)
                for member in chain["members"]:
                    detail = call(checks.environment, {"Read": {"input": {"project": project["project"], "selection": {"ItemDetail": {"id": member["id"]}}}}})
                    assert detail["Detail"]["view"]["item"]["revision"] == member["revision"], "Baseline task changed after candidate review; a fresh evaluation is required for exact-revision assessment"
                selection = {"Summary": {"filter": {"EvaluationOnly": {"run": settings["evaluation"]["run"], "scenario": settings["evaluation"]["scenario"]}}}}
                baseline_summary = call(checks.environment, {"Usage": {"input": {"project": project["project"], "selection": selection}}})
                write(evidence / "baseline-usage-summary.json", baseline_summary)
                try:
                    began = time.monotonic()
                    with (evidence / "governor.stdout").open("w") as out, (evidence / "governor.stderr").open("w") as err:
                        finished = subprocess.run(command + ["run", baseline["harness"] if correcting else "claude", "--settings", str(evidence / "settings.json"), "--input", str(evidence / "request.txt")],
                                                  cwd=consumer, env=environment, stdout=out, stderr=err, timeout=evaluation["EXECUTION_MILLIS"] / 1000 + 120)
                    result.update(exit=finished.returncode, elapsedSeconds=round(time.monotonic() - began, 3))
                    sessions = list((evidence / "sessions").iterdir())
                    assert len(sessions) == 1, "Expected one assessment governing session"
                    session = sessions[0]
                    reviews = [json.loads(path.read_text()) for path in (session / "children").glob("*/receipt.json")]
                    write(evidence / "dispatch-statuses.json", reviews)
                    retained = evaluation["artifacts"](checks.environment, evidence, session, reviews)
                    assert correcting or len(reviews) == 1, "Expected exactly one independent reviewer receipt"
                finally:
                    primary_failure = sys.exc_info()[0] is not None
                    result["archiveErrors"] = evaluation["archive"](checks, evidence)
                    if result["archiveErrors"] and not primary_failure:
                        raise RuntimeError("; ".join(result["archiveErrors"]))
                attempts = json.loads((evidence / "attempts.json").read_text())["UsageAttempts"]["page"]["entries"]
                assert all(value["assignment"]["evaluation"] == settings["evaluation"] for value in attempts)
                if not correcting:
                    assert len(attempts) == 2 and any(value["attempt"]["role"] == "Reviewer" and value["attempt"]["model"] == "gpt-6-astra" for value in attempts)
                combined = call(checks.environment, {"Usage": {"input": {"project": project["project"], "selection": selection}}})
                write(evidence / "combined-usage-summary.json", combined)
                baseline_usage = baseline_summary["UsageSummary"]["report"]
                assessor_usage = json.loads((evidence / "usage-summary.json").read_text())["UsageSummary"]["report"]
                combined_usage = combined["UsageSummary"]["report"]
                for attribution in ["direct", "shared", "unattributed"]:
                    for counter in ["input", "output", "cacheRead", "cacheWrite", "reasoning", "total"]:
                        for quantity in ["known", "unknown", "estimated"]:
                            assert int(combined_usage[attribution][counter][quantity]) == sum(
                                int(report[attribution][counter][quantity]) for report in [baseline_usage, assessor_usage]), "Assessment usage was lost or counted twice"
                    assert int(combined_usage[attribution]["unknownCosts"]) == sum(
                        int(report[attribution]["unknownCosts"]) for report in [baseline_usage, assessor_usage]), "Unknown assessment costs were lost or counted twice"

                def costs(reports):
                    totals = {}
                    for report in reports:
                        assert not report["costs"]["hasMore"], "Cost reconciliation requires complete cost groups"
                        for entry in report["costs"]["entries"]:
                            key = json.dumps(entry["group"], sort_keys=True)
                            amount, measurements = totals.get(key, (Fraction(0), 0))
                            totals[key] = (amount + Fraction(entry["amount"]["value"]), measurements + int(entry["measurements"]))
                    return totals

                assert costs([combined_usage]) == costs([baseline_usage, assessor_usage]), "Assessment cost groups were lost or counted twice"
                result.update(attempts=len(attempts), accounting="reconciled")
                if not correcting:
                    assert reviews[0]["phase"] == "Completed" and reviews[0]["result"] is not None, "Independent reviewer did not complete: " + str(reviews[0]["blocker"])
                assessment = predicates["corrected_chain"](workers + reviews, retained, checks_by_name, chain, previous, worker, reviewer) if correcting else accepted_chain(workers + reviews, retained, checks_by_name)
                assert finished.returncode == 0, "Governing run failed"
                assert assessment["reviewer"] in [value["attempt"] for value in reviews]
                if not correcting:
                    assert assessment["candidate"] == chain["candidate"] and assessment["reviewerHarness"] == "Codex", "Independent assessment changed its candidate or route"
                write(evidence / "accepted-chain.json", assessment)
                result["acceptedChain"] = assessment
                result.update(status="candidate-passed" if correcting else "assessment-passed", candidate=assessment["candidate"], attempts=len(attempts))
    except BaseException as error:
        result.update(status="failed", error=str(error))
        raise
    finally:
        write(evidence / "result.json", result)
    print("PASS:", "candidate correction" if correcting else "independent candidate assessment", "; human acceptance remains pending; evidence", evidence, flush=True)


if __name__ == "__main__":
    main()
