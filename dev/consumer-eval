#!/usr/bin/env python3
"""Explicit live-model consumer evaluation; accounting comes from CQ's audit."""
import datetime
import argparse
import contextlib
import getpass
import hashlib
import json
import os
from pathlib import Path
import runpy
import shutil
import subprocess
import sys
import time
import urllib.parse
import urllib.request
import uuid


ROOT = Path(__file__).resolve().parent.parent
PROFILES = {
    "claude": ("Claude", "claude-opus-5-5", "anthropic", "2.1.280"),
    "codex": ("Codex", "gpt-6-sol", "openai", "0.156.1"),
    "pi": ("Pi", "gpt-5.5", "openai-codex", "0.87.1"),
}
ROUTES = {"claude": ("codex", "pi"), "codex": ("pi", "claude"), "pi": ("claude", "codex")}
EXECUTION_MILLIS = 900000
MAX_PAGES = 200


def write(path, value):
    path.write_text(json.dumps(value, indent=2) + "\n")


def same_runtime(first, second):
    if first is None or second is None:
        return first is second
    return all(first[key] == second[key] for key in ["manifestSha256", "executableSha256", "guardianSha256"])


def runtime(checks, release, previous):
    if release is not None:
        command, guardian, identity = runpy.run_path(str(ROOT / "dev/package"))["load_release"](release)
        if previous is not None:
            assert same_runtime(identity, previous), "Release differs from the retained producer artifact"
        return command, guardian, identity
    assert previous is None, "A packaged baseline requires an explicit --release for every later stage"
    checks.generate()
    command = ["java", "-cp", checks.classpath(), "cq.server.Main"]
    guardian = checks.evidence / "cq-guardian"
    checks.run(["gcc", "-std=c17", "-O2", "-Wall", "-Wextra", "-Werror", "-o", str(guardian), "host/native/guardian.c"], "guardian-build", 60)
    return command, guardian, None


def call(environment, body):
    request = urllib.request.Request(environment["CQ_ORIGIN"] + "/api/call", data=json.dumps(body).encode(), headers={
        "Authorization": "Bearer " + environment["CQ_TOKEN"], "CQ-Session": environment["CQ_SESSION"],
        "CQ-Protocol-Version": "0.1.0", "Content-Type": "application/json"})
    with urllib.request.urlopen(request, timeout=15) as response:
        payload = response.read(2 * 1024 * 1024 + 1)
        assert len(payload) <= 2 * 1024 * 1024, "Evaluation export response exceeded its byte bound"
        result = json.loads(payload)
        assert "Failed" not in result, result
        return result


def export(environment, evidence, session):
    run = json.loads((session / "run.json").read_text())
    project = run["project"]["project"]
    filter_value = {"SessionOnly": {"id": run["attempt"]["session"]}}

    def usage(selection):
        return call(environment, {"Usage": {"input": {"project": project, "selection": selection}}})

    write(evidence / "usage-summary.json", usage({"Summary": {"filter": filter_value}}))
    attempts = usage({"Attempts": {"filter": filter_value, "after": None, "snapshot": None, "limit": 100}})
    assert not attempts["UsageAttempts"]["page"]["hasMore"], "Attempt export exceeds configured child bound"
    write(evidence / "attempts.json", attempts)
    for value in attempts["UsageAttempts"]["page"]["entries"]:
        attempt = value["attempt"]["id"]
        page = usage({"Outcomes": {"attempt": attempt, "after": "0", "limit": 200}})
        assert not page["UsageOutcomes"]["page"]["hasMore"], "Outcome export exceeded its bound"
        write(evidence / ("outcomes-" + attempt["value"] + ".json"), page)
    after = "0"
    for index in range(MAX_PAGES):
        page = usage({"Audit": {"filter": filter_value, "after": after, "limit": 200}})
        write(evidence / f"usage-audit-{index:03d}.json", page)
        body = page["UsageAudit"]["page"]
        if not body["hasMore"]:
            break
        assert int(body["after"]) > int(after), "Audit export made no progress"
        after = body["after"]
    else:
        raise AssertionError("Audit export exceeded its page bound")
    export_meters(environment, evidence, project, run["attempt"]["session"])
    return attempts["UsageAttempts"]["page"]["entries"]


def export_meters(environment, evidence, project, session):
    parsed = urllib.parse.urlsplit(environment["CQ_DATABASE_URL"].removeprefix("jdbc:"))
    assert not parsed.query, "Evaluation meter export requires its isolated database"
    project_id, session_id = uuid.UUID(project["value"]), uuid.UUID(session["value"])
    query = f"""SELECT coalesce(jsonb_agg(jsonb_build_object('assignment',a.body,'attempt',t.body,'meter',m.body,'projection',m.projection)
      ORDER BY m.attempt_id,m.meter),'[]'::jsonb)
      FROM cq_usage_meters m JOIN cq_usage_attempts t USING(project_id,attempt_id)
      JOIN cq_usage_assignments a ON a.project_id=t.project_id AND a.assignment_id=t.assignment_id
      WHERE t.project_id='{project_id}'::uuid AND t.session_id='{session_id}'::uuid"""
    output = subprocess.check_output(["psql", "--no-psqlrc", "--set", "ON_ERROR_STOP=1", "--tuples-only", "--no-align",
        "--host", parsed.hostname, "--port", str(parsed.port), "--username", environment["CQ_DATABASE_USER"], "--dbname", parsed.path[1:],
        "--command", query], env=dict(environment, PGPASSWORD=environment["CQ_DATABASE_PASSWORD"]), text=True, timeout=30)
    write(evidence / "usage-meters.json", {"source": "CQ operational meter projections, read from the isolated evaluation database",
                                          "project": project, "session": session, "entries": json.loads(output)})


def artifacts(environment, evidence, session, statuses, additional):
    project = json.loads((session / "run.json").read_text())["project"]["project"]
    found = {}
    pending = [value["result"] for value in statuses if value["result"] is not None]
    pending.extend(additional)
    pending.extend(ticket["selection"] for path in (session / "children").glob("*/ticket.json")
                   if (ticket := json.loads(path.read_text()))["selection"] is not None)
    while pending:
        handle = pending.pop()
        if handle["value"] in found:
            continue
        assert len(found) < 300, "Consumer result/validation export exceeded its bound"
        metadata = call(environment, {"Read": {"input": {"project": project, "selection": {"ArtifactInfo": {"id": handle}}}}})["ArtifactInfo"]["metadata"]
        assert metadata["bytes"] <= 256 * 1024 and metadata["mediaType"] == "application/json"
        parts = []
        offset = 0
        for _ in range(33):
            page = call(environment, {"Read": {"input": {"project": project, "selection": {"ArtifactText": {"id": handle, "offset": offset, "limit": 8192}}}}})["ArtifactText"]["page"]
            assert page["metadata"] == metadata and page["offset"] == offset and page["next"] == offset + len(page["text"])
            parts.append(page["text"])
            if not page["hasMore"]:
                break
            assert page["next"] > offset
            offset = page["next"]
        else:
            raise AssertionError("Artifact export exceeded its page bound")
        text = "".join(parts)
        body = text.encode()
        assert len(text) == metadata["codePoints"] and len(body) == metadata["bytes"] and hashlib.sha256(body).hexdigest() == metadata["sha256"]
        value = {**metadata, "body": json.loads(text)}
        found[handle["value"]] = value
        if metadata["kind"] == "Result":
            input_id = uuid.UUID(bytes=hashlib.md5((metadata["attempt"]["value"] + ":input").encode()).digest(), version=3)
            pending.append({"value": str(input_id)})
            pending.extend(entry["artifact"] for entry in value["body"]["validation"])
            pending.extend(value["body"]["request"]["artifacts"])
            if value["body"]["request"]["previous"] is not None:
                pending.append(value["body"]["request"]["previous"])
    write(evidence / "candidate-evidence.json", found)
    return found


@contextlib.contextmanager
def database(checks, evidence, port):
    data = evidence / "postgres-data"
    checks.run(["initdb", "-D", str(data), "--auth=trust", "--encoding=UTF8", "--no-locale"], "database-init", 60)
    checks.run(["pg_ctl", "-D", str(data), "-l", str(evidence / "postgres.log"), "-o", f"-h 127.0.0.1 -p {port} -k ''", "-w", "start"], "database-start", 60)
    checks.environment.update(CQ_DATABASE_URL=f"jdbc:postgresql://127.0.0.1:{port}/postgres", CQ_DATABASE_USER=getpass.getuser(), CQ_DATABASE_PASSWORD="")
    try:
        yield
    finally:
        checks.run(["pg_ctl", "-D", str(data), "-m", "fast", "-w", "stop"], "database-stop", 20)


def archive(checks, evidence):
    errors = []
    try:
        sessions = list((evidence / "sessions").iterdir())
        assert len(sessions) == 1, "Expected one retained governing session"
        export(checks.environment, evidence, sessions[0])
    except Exception as error:
        errors.append("Audit export: " + str(error))
    try:
        parsed = urllib.parse.urlsplit(checks.environment["CQ_DATABASE_URL"].removeprefix("jdbc:"))
        checks.run(["pg_dump", "--host", parsed.hostname, "--port", str(parsed.port), "--username", checks.environment["CQ_DATABASE_USER"],
                    "--dbname", parsed.path[1:], "--format=custom", "--file", str(evidence / "cq-database.dump")], "database-export", 60)
    except Exception as error:
        errors.append("Database archive: " + str(error))
    write(evidence / "archive.json", {"errors": errors, "retainedDatabase": str(evidence / "postgres-data")})
    return errors


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("harness", choices=PROFILES)
    parser.add_argument("language", choices=["python", "go"])
    parser.add_argument("--cohort", action="store_true", help="Run managed two-task selection with Planner, shared Worker and fresh reviewer checks")
    parser.add_argument("--release", type=Path, help="Use this native distribution without generation or JVM/guardian builds")
    arguments = parser.parse_args()
    required = ["go", "initdb"] + (["java", "sbt"] if arguments.release is None else [])
    if any(shutil.which(command) is None for command in required):
        os.execvp("nix", ["nix", "develop", str(ROOT), "-c", str(ROOT / "dev/consumer-eval"), *sys.argv[1:]])
    arguments.release = arguments.release.resolve() if arguments.release is not None else None
    os.chdir(ROOT)
    harness, language = arguments.harness, arguments.language
    cohort = runpy.run_path(str(ROOT / "dev/consumer-cohort.py"))
    worker, reviewer = ROUTES[harness]
    planner = worker
    if arguments.cohort:
        worker = harness
    mode = "cohort-consumer" if arguments.cohort else "consumer"
    identifier = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S") + f"-{mode}-{harness}-{language}"
    evidence = Path(os.environ.get("CQ_EVIDENCE_ROOT", str(ROOT / ".work/evidence"))).resolve() / identifier
    evidence.mkdir(parents=True, mode=0o700)
    print("Evidence:", evidence, flush=True)
    files = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"]).decode().split("\0")
    write(evidence / "source-sha256.json", {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest() for name in sorted(set(files)) if name and (ROOT / name).is_file()})
    module = runpy.run_path(str(ROOT / "dev/check"))
    checks = module["Checks"](evidence, dict(os.environ))
    routes = []
    for key, (native, model, provider, version) in PROFILES.items():
        executable = shutil.which(key)
        assert executable is not None, f"Configured harness missing: {key}"
        routes.append({"harness": native, "executable": executable,
                       "model": os.environ.get(f"CQ_{key.upper()}_MODEL", model), "provider": os.environ.get(f"CQ_{key.upper()}_PROVIDER", provider),
                       "version": version, "providerExtensions": [], "providerEnvironment": []})
    result = {"status": "running", "baseline": subprocess.check_output(["git", "rev-parse", "HEAD"]).decode().strip(),
              "harness": harness, "language": language, "worker": worker, "reviewer": reviewer, "routes": routes,
              "cohort": arguments.cohort, "planner": planner if arguments.cohort else None,
              "remaining": ["candidate integration", "independent evaluation assessment", "M2 human acceptance"],
              "scope": "real consumer candidate build and host validation; no efficiency conclusion from a single run"}
    write(evidence / "result.json", result)
    try:
        command, guardian, result["release"] = runtime(checks, arguments.release, None)
        write(evidence / "result.json", result)
        checks.run(["go", "version"], "go-version", 10)
        checks.run(["python3", "--version"], "python-version", 10)
        for route in routes:
            observed = checks.run([route["executable"], "--version"], "version-" + route["harness"].lower(), 15)
            assert route["version"] in observed, "Configured harness version differs from the installed executable"
        consumer = evidence / "consumer"
        consumer.mkdir()
        checks.run(["git", "init", "--quiet", str(consumer)], "consumer-init", 10)
        checks.run(["git", "-C", str(consumer), "-c", "user.name=CQ evaluation", "-c", "user.email=cq@example.invalid", "commit", "--quiet", "--allow-empty", "-m", "Evaluation base"], "consumer-base", 10)
        settings = {"integrationTarget": None, "stateRoot": str(evidence / "sessions"), "guardian": str(guardian), "harnesses": routes,
                    "limits": {"startupMillis": "10000", "executionMillis": str(EXECUTION_MILLIS), "heartbeatMillis": "2000",
                               "graceMillis": "1000", "killMillis": "3000", "retainedOutputBytes": 8 * 1024 * 1024},
                    "checks": [{"name": "consumer-oracle", "command": [sys.executable, str(ROOT / "dev/consumer-oracle.py"), language],
                                "executionMillis": "180000", "retainedOutputBytes": 262144, "attempts": 1, "revalidations": 0}],
                    "evaluation": {"run": identifier, "scenario": ("cohort-wordfreq-" if arguments.cohort else "wordfreq-") + language, "assessor": False}}
        write(evidence / "settings.json", settings)
        request = (f"Build the following unrelated consumer in {language}. Create one CQ task containing the complete specification below and claim it. "
                   f"Dispatch {PROFILES[worker][0]} Worker Implement with that exact task revision; after host validation passes, dispatch {PROFILES[reviewer][0]} Reviewer using its result handle. "
                   "Use references only; do not read or compose child prompts or read full child result bodies. Use compact status for correction loops when necessary. "
                   "After the accepted review, retain the exact reviewed task revision for the separate assessment step: release its claim and report handles without editing the task. "
                   "Keep process startup at 10000 ms, heartbeat at 2000 ms, grace at 1000 ms, kill at 3000 ms and output at 8388608 bytes; execution may use the supplied session limit. "
                   "Return after a host-validated candidate and accepted review, or report the concrete blocker. Integration is pending and must not be claimed.\n\n" + (ROOT / "dev/consumer-spec.md").read_text())
        (evidence / "request.txt").write_text(request)
        port = module["free_port"]()
        checks.environment.update(CQ_HOST="127.0.0.1", CQ_PORT=str(port), CQ_ORIGIN=f"http://127.0.0.1:{port}", CQ_TOKEN=uuid.uuid4().hex + uuid.uuid4().hex, CQ_SESSION=str(uuid.uuid4()))
        with database(checks, evidence, module["free_port"]()):
            with checks.server(command, "consumer-server"):
                environment = {name: value for name, value in checks.environment.items() if not name.startswith("CQ_")}
                environment["CQ_TOKEN"] = checks.environment["CQ_TOKEN"]
                with (evidence / "cq-init.log").open("w") as log:
                    subprocess.run(command + ["init", "--endpoint", checks.environment["CQ_ORIGIN"]], cwd=consumer, env=environment, stdout=log, stderr=subprocess.STDOUT, timeout=30, check=True)
                try:
                    workflow = []
                    if arguments.cohort:
                        project = json.loads((consumer / ".git/cq/project.json").read_text())["project"]
                        seed = cohort["seed"](lambda body: call(checks.environment, body), project, language, (ROOT / "dev/consumer-spec.md").read_text())
                        write(evidence / "cohort-seed.json", seed)
                        (evidence / "request.txt").write_text(cohort["request"](seed, PROFILES[planner][0], PROFILES[worker][0], PROFILES[reviewer][0]))
                        workflow = ["--workflow", "advance", "--roots", "G" + seed["goal"]["id"]["number"], "--through", "review"]
                    began = time.monotonic()
                    with (evidence / "governor.stdout").open("w") as out, (evidence / "governor.stderr").open("w") as err:
                        finished = subprocess.run(command + ["run", harness, "--settings", str(evidence / "settings.json"), "--input", str(evidence / "request.txt")] + workflow,
                                                  cwd=consumer, env=environment, stdout=out, stderr=err, timeout=EXECUTION_MILLIS / 1000 + 120)
                    result.update(exit=finished.returncode, elapsedSeconds=round(time.monotonic() - began, 3))
                    sessions = list((evidence / "sessions").iterdir())
                    assert len(sessions) == 1, "Expected one retained governing session"
                    session = sessions[0]
                    statuses = [json.loads(path.read_text()) for path in (session / "children").glob("*/receipt.json")]
                    write(evidence / "dispatch-statuses.json", statuses)
                    values = artifacts(checks.environment, evidence, session, statuses, [])
                    chain = runpy.run_path(str(ROOT / "dev/consumer-evidence.py"))["accepted_chain"](statuses, values, {value["name"]: value for value in settings["checks"]})
                    assert finished.returncode == 0, "Governing process did not complete successfully"
                    assert chain["workerHarness"] == PROFILES[worker][0] and chain["reviewerHarness"] == PROFILES[reviewer][0], "Accepted chain used another configured route"
                    project = json.loads((session / "run.json").read_text())["project"]["project"]
                    assessment_members = seed["members"] if arguments.cohort else chain["members"]
                    handoff = call(checks.environment, {"Read": {"input": {"project": project, "selection": {
                        "Claims": {"members": [value["id"] for value in assessment_members]}}}}})
                    write(evidence / "assessment-handoff.json", handoff)
                    cohort["assessment_handoff"]({"members": assessment_members}, handoff["Claims"]["preview"])
                    write(evidence / "accepted-chain.json", chain)
                    result.update(status="candidate-passed", acceptedChain=chain)
                finally:
                    primary_failure = sys.exc_info()[0] is not None
                    result["archiveErrors"] = archive(checks, evidence)
                    if result["archiveErrors"] and not primary_failure:
                        raise RuntimeError("; ".join(result["archiveErrors"]))
                attempts = json.loads((evidence / "attempts.json").read_text())["UsageAttempts"]["page"]["entries"]
                assert all(value["assignment"]["evaluation"] == settings["evaluation"] for value in attempts), "Evaluation attribution was not inherited"
                assert {value["attempt"]["harness"] for value in attempts} == set(value[0] for value in PROFILES.values()), "Evaluation did not use all required routes"
                result["attempts"] = len(attempts)
                if arguments.cohort:
                    tickets = {ticket["attempt"]["id"]["value"]: ticket for path in (session / "children").glob("*/ticket.json")
                               if (ticket := json.loads(path.read_text()))}
                    observations = [entry for path in sorted(evidence.glob("usage-audit-*.json"))
                                    for entry in json.loads(path.read_text())["UsageAudit"]["page"]["entries"]]
                    governor = json.loads((session / "run.json").read_text())["attempt"]
                    expected_routes = {"Governor": PROFILES[harness][0], "Planner": PROFILES[planner][0], "Worker": PROFILES[worker][0], "Reviewer": PROFILES[reviewer][0]}
                    proof = cohort["accepted"](chain, statuses, values, tickets, attempts, observations, seed, governor, expected_routes, {value["name"]: value for value in settings["checks"]},
                                               json.loads((session / "run.json").read_text())["base"])
                    write(evidence / "accepted-cohort.json", proof)
    except BaseException as error:
        result.update(status="failed", error=str(error))
        raise
    finally:
        write(evidence / "result.json", result)
    print(f"PASS: {harness}/{language} real consumer candidate; integration and milestone acceptance remain pending; evidence {evidence}", flush=True)


if __name__ == "__main__":
    main()
