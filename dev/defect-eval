#!/usr/bin/env python3
"""Run retained native defect intake and empirical investigation checkpoints."""
import argparse
import datetime
import hashlib
import json
import os
from pathlib import Path
import runpy
import shutil
import shlex
import subprocess
import sys
import time
import uuid
import urllib.parse
import urllib.request


def snapshot(call, project, consumer, session):
    found = call({"Search": {"input": {"project": project, "query": "archived:true OR archived:false", "after": None, "snapshot": None, "limit": 100}}})["Found"]["page"]
    assert not found["hasMore"], "Defect snapshot exceeds its bound"
    views, histories = [], []
    def read(selection):
        return call({"Read": {"input": {"project": project, "selection": selection}}})
    for item in found["items"]:
        views.append(read({"ItemDetail": {"id": item["id"]}})["Detail"]["view"])
        histories.append({"id": item["id"], "page": read({"History": {"id": item["id"], "before": {"value": str(int(item["revision"]["value"]) + 1)}, "limit": 100}})["History"]["page"]})
    claims = read({"Claims": {"members": [value["id"] for value in found["items"]]}})["Claims"]["preview"]
    return {"views": views, "histories": histories, "claims": claims,
        "git": {"value": subprocess.check_output(["git", "-C", str(consumer), "rev-parse", "HEAD"], text=True).strip()},
        "clean": not subprocess.check_output(["git", "-C", str(consumer), "status", "--porcelain", "--untracked-files=all"], text=True).strip(),
        "localIntegrations": [] if session is None else [json.loads(path.read_text()) for path in (session / "integrations").glob("*.json")]}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("stage", choices=["begin", "probe", "research", "plan", "integrate", "upstream", "assess", "verify-plan"])
    parser.add_argument("--checkpoint", type=Path)
    parser.add_argument("--experiments", type=Path, help="Retained experimental usage report, required only for assess")
    parser.add_argument("--release", type=Path)
    arguments = parser.parse_args()
    if (arguments.stage == "begin") != (arguments.checkpoint is None):
        parser.error("continuations and verify-plan require --checkpoint; begin does not accept one")
    if (arguments.stage == "assess") != (arguments.experiments is not None):
        parser.error("assess requires --experiments; other stages do not accept it")
    root = Path(__file__).resolve().parent.parent
    if arguments.stage == "verify-plan":
        if arguments.release is not None:
            parser.error("verify-plan replays retained evidence without a runtime; --release applies to executable stages")
        verified = runpy.run_path(str(root / "dev/defect-plan-replay.py"))["verify"](arguments.checkpoint.resolve())
        print("PLAN RE-VERIFIED:", len(verified["attemptIds"]), "distinct chain attempts; original failed manifest preserved", flush=True)
        return
    required = ["pg_ctl"] + (["java", "sbt"] if arguments.release is None else [])
    if any(shutil.which(name) is None for name in required):
        os.execvp("nix", ["nix", "develop", str(root), "-c", str(root / "dev/defect-eval"), *sys.argv[1:]])
    arguments.release = arguments.release.resolve() if arguments.release is not None else None
    arguments.checkpoint = arguments.checkpoint.resolve() if arguments.checkpoint is not None else None
    arguments.experiments = arguments.experiments.resolve() if arguments.experiments is not None else None
    os.chdir(root)
    evaluation = runpy.run_path(str(root / "dev/consumer-eval"))
    support = runpy.run_path(str(root / "dev/check"))
    predicates = runpy.run_path(str(root / "dev/defect-evidence.py"))
    process = runpy.run_path(str(root / "dev/process-assess-evidence.py"))
    reconcile = runpy.run_path(str(root / "dev/process-evidence.py"))["reconcile_usage"]
    write, call = evaluation["write"], evaluation["call"]
    original = None if arguments.checkpoint is None else arguments.checkpoint.resolve()
    prior = None if original is None else predicates["checkpoint"](original)
    if prior is not None:
        assert prior["manifest"]["stage"] == {"probe": "begin", "research": "probe", "plan": "research", "integrate": "plan", "upstream": "integrate", "assess": "upstream"}[arguments.stage], "Continuation requires the immediately preceding verified stage"
        hashes = json.loads((original / "source-sha256.json").read_text())
        for path in [*sorted((root / "dev/fixtures/defect").glob("*.py")), root / "dev/fixtures/defect/README.md", root / "dev/defect-oracle.py"]:
            assert hashlib.sha256(path.read_bytes()).hexdigest() == hashes[str(path.relative_to(root))], "Fixture/oracle changed since checkpoint"
    identifier = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%S") + "-defect-" + arguments.stage
    evidence = Path(os.environ.get("CQ_EVIDENCE_ROOT", "/srv/nvme/tmp/cq4-implementation")).resolve() / identifier
    evidence.mkdir(parents=True, mode=0o700)
    print("Evidence:", evidence, flush=True)
    files = subprocess.check_output(["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"]).decode().split("\0")
    write(evidence / "source-sha256.json", {name: hashlib.sha256((root / name).read_bytes()).hexdigest() for name in sorted(set(files)) if name and (root / name).is_file()})
    checks = support["Checks"](evidence, dict(os.environ))
    result = {"status": "running", "stage": arguments.stage, "implementation": subprocess.check_output(["git", "rev-parse", "HEAD"]).decode().strip(),
              "remaining": ["empirical probes and adjudication", "reviewed repair and integration", "upstream preparation", "independent process assessment"]}
    if prior is not None:
        result.update(baselineEvidence=str(original), baselineDumpSha256=prior["dumpSha256"])
    write(evidence / "result.json", result)
    try:
        consumer = evidence / "consumer"
        if prior is None:
            shutil.copytree(root / "dev/fixtures/defect", consumer, ignore=shutil.ignore_patterns("__pycache__"))
            checks.run(["git", "init", "--quiet", str(consumer)], "consumer-init", 10)
            checks.run(["git", "-C", str(consumer), "add", "."], "consumer-stage", 10)
            checks.run(["git", "-C", str(consumer), "-c", "user.name=CQ evaluation", "-c", "user.email=cq@example.invalid", "commit", "--quiet", "-m", "Synthetic dependency defect fixture"], "consumer-base", 10)
        else:
            checks.run(["git", "clone", "--quiet", "--no-hardlinks", str(original / "consumer"), str(consumer)], "consumer-clone", 30)
        if arguments.stage in ["upstream", "assess"]:
            checks.run(["git", "-C", str(consumer), "checkout", "--quiet", "--detach", prior["manifest"]["proof"]["candidate"]["value"]], "consumer-candidate", 10)
        (consumer / ".git/info/exclude").write_text("__pycache__/\n")
        base = {"value": subprocess.check_output(["git", "-C", str(consumer), "rev-parse", "HEAD"], text=True).strip()}
        reproduction = subprocess.run([sys.executable, "-m", "unittest", "-v"], cwd=consumer, text=True, capture_output=True, timeout=30)
        write(evidence / "reproduction.json", {"command": [sys.executable, "-m", "unittest", "-v"], "commit": base, "exit": reproduction.returncode,
                                               "stdout": reproduction.stdout, "stderr": reproduction.stderr})
        if arguments.stage in ["upstream", "assess"]:
            assert reproduction.returncode == 0, "Incorporated consumer no longer passes its tests"
        else:
            assert reproduction.returncode == 1 and "FAIL: test_ascii_delimiters" in reproduction.stderr and "Ran 4 tests" in reproduction.stderr and "FAILED (failures=1)" in reproduction.stderr, "Fixture did not reproduce its intended defect"
        oracle = subprocess.run([sys.executable, str(root / "dev/defect-oracle.py")], cwd=consumer, text=True, capture_output=True, timeout=60)
        write(evidence / "oracle-before.json", {"exit": oracle.returncode, "stdout": oracle.stdout, "stderr": oracle.stderr,
                                                "sha256": hashlib.sha256((root / "dev/defect-oracle.py").read_bytes()).hexdigest()})
        if arguments.stage in ["upstream", "assess"]:
            assert oracle.returncode == 0 and json.loads(oracle.stdout) == {"status": "passed", "cases": 26, "consumerTests": "passed"}, "Incorporated consumer no longer passes the unchanged oracle"
        else:
            assert oracle.returncode == 1 and "'case': 1" in oracle.stderr and "AssertionError" in oracle.stderr, "Oracle did not reproduce the ASCII contract failure"
        previous = prior["manifest"].get("release") if prior is not None else None
        if prior is not None:
            assert (arguments.release is None) == (previous is None), "Continuation must use the checkpoint's recorded runtime kind"
        command, guardian, result["release"] = evaluation["runtime"](checks, arguments.release, previous)
        write(evidence / "result.json", result)
        routes = []
        for name, (harness, model, provider, version) in evaluation["PROFILES"].items():
            executable = shutil.which(name)
            assert executable is not None, "Missing configured harness: " + name
            observed = checks.run([executable, "--version"], "version-" + name, 15)
            assert version in observed, f"Configured {name} differs from pinned {version}: {observed.strip()}"
            routes.append({"harness": harness, "executable": executable, "model": model, "provider": provider, "version": version,
                           "providerExtensions": [], "providerEnvironment": []})
        settings = {"integrationTarget": None, "stateRoot": str(evidence / "sessions"), "guardian": str(guardian), "harnesses": routes,
                    "limits": {"startupMillis": "10000", "executionMillis": str(evaluation["EXECUTION_MILLIS"]), "heartbeatMillis": "2000",
                               "graceMillis": "1000", "killMillis": "3000", "retainedOutputBytes": 8388608}, "checks": [],
                    "evaluation": {"run": identifier, "scenario": "synthetic-dependency", "assessor": False}}
        if prior is not None:
            settings["evaluation"] = json.loads((original / "settings.json").read_text())["evaluation"]
        if arguments.stage == "assess":
            settings["evaluation"]["assessor"] = True
            next(route for route in routes if route["harness"] == "Codex")["model"] = "gpt-6-astra"
        if arguments.stage == "integrate":
            checks.run(["git", "-C", str(consumer), "branch", "integration"], "integration-branch", 10)
            settings["integrationTarget"] = "refs/heads/integration"
            settings["checks"] = [{"name": "defect-oracle", "command": [sys.executable, str(root / "dev/defect-oracle.py")],
                                   "executionMillis": "180000", "retainedOutputBytes": 262144, "attempts": 1, "revalidations": 0}]
        write(evidence / "settings.json", settings)
        request = (root / "dev/defect-begin.md").read_text() + "\n\n" + json.dumps({"fixtureCommit": base, "specification": (consumer / "README.md").read_text(),
            "reproduction": {"command": "python3 -m unittest -v", "exit": reproduction.returncode, "stdout": reproduction.stdout, "stderr": reproduction.stderr}}, ensure_ascii=False)
        (evidence / "request.txt").write_text(request)
        port = support["free_port"]()
        checks.environment.update(CQ_HOST="127.0.0.1", CQ_PORT=str(port), CQ_ORIGIN=f"http://127.0.0.1:{port}",
                                  CQ_TOKEN=uuid.uuid4().hex + uuid.uuid4().hex, CQ_SESSION=str(uuid.uuid4()))
        with evaluation["database"](checks, evidence, support["free_port"]()):
            if prior is not None:
                parsed = urllib.parse.urlsplit(checks.environment["CQ_DATABASE_URL"].removeprefix("jdbc:"))
                checks.run(["pg_restore", "--exit-on-error", "--clean", "--if-exists", "--host", parsed.hostname, "--port", str(parsed.port),
                            "--username", checks.environment["CQ_DATABASE_USER"], "--dbname", parsed.path[1:], str(prior["dump"])], "database-restore", 60)
            with checks.server(command, "defect-server"):
                environment = {name: value for name, value in checks.environment.items() if not name.startswith("CQ_")}
                environment["CQ_TOKEN"] = checks.environment["CQ_TOKEN"]
                init = ["init", "--endpoint", checks.environment["CQ_ORIGIN"]]
                if prior is not None:
                    project_config = prior["values"]["run"]["project"]
                    init += ["--project-id", project_config["project"]["value"], "--name", project_config["name"]]
                with (evidence / "cq-init.log").open("w") as log:
                    subprocess.run(command + init, cwd=consumer,
                                   env=environment, stdout=log, stderr=subprocess.STDOUT, timeout=30, check=True)
                project = json.loads((consumer / ".git/cq/project.json").read_text())["project"]
                api = lambda value: call(checks.environment, value)
                def total_usage():
                    return api({"Usage": {"input": {"project": project, "selection": {"Summary": {"filter": {"EvaluationOnly": {
                        "run": settings["evaluation"]["run"], "scenario": settings["evaluation"]["scenario"]}}}}}}})
                workflow = ["--workflow", "begin"]
                if prior is not None:
                    before = snapshot(api, project, consumer, None)
                    write(evidence / "before.json", before)
                    expected = predicates["continuation"](prior)
                    predicates["restored"](before, expected)
                    assert base == expected["git"], "Restored Git base differs from its archive"
                    restored = total_usage()
                    write(evidence / "baseline-usage-summary.json", restored)
                    reconcile([prior["usage"]], restored["UsageSummary"]["report"])
                    if arguments.stage in ["upstream", "assess"]:
                        intake = runpy.run_path(str(root / "dev/defect-upstream-evidence.py"))["scope"](before)
                    else:
                        intake = prior["manifest"]["proof"] if arguments.stage == "integrate" else predicates["records"](before)
                    members = intake["branches"] if arguments.stage == "probe" else [intake["research"]]
                    if arguments.stage in ["integrate", "assess"]:
                        members = [intake["task"]]
                    if arguments.stage == "upstream":
                        members = [intake[key] for key in ["defect", "goal", "milestone"]]
                    guidance = [{"id": view["item"]["id"], "revision": view["item"]["revision"]} for view in before["views"] if view["item"]["id"] not in members]
                    bundle = {"provenance": "Runner-provided empirical input, not human judgment or new HostObserved validation", "fixture": base}
                    if arguments.stage == "probe":
                        program = (root / "dev/defect-probe-capture.py").read_bytes()
                        recorder_file = evidence / "probe-recorder.py"
                        recorder_file.write_bytes(program)
                        recorder = {"path": str(recorder_file), "sha256": hashlib.sha256(program).hexdigest()}
                        probe_command = runpy.run_path(str(root / "dev/defect-probe-evidence.py"))["command"](recorder)
                        bundle.update(recorder=recorder, command=shlex.join(probe_command),
                            instructions="Execute the supplied short command exactly through your native command tool in the assigned workspace, without pipelines or modifications. It reads the retained recorder, checks its SHA-256, and executes those same bytes. Do not copy or rewrite the recorder into your workspace. If it cannot be read, report the blocker; do not substitute another program. It records R1's proposed observations and H3's nonconforming-token injection without requiring any causal verdict. Do not implement or adjudicate. Preserve cq-probe-observations.json as the only new workspace file; leave tracked files and HEAD unchanged. Include any supplemental observations directly in your Result artifact, without creating supplemental reports or other workspace files. Interpret actual results for each assigned hypothesis and report ModelDeclared findings or honest inconclusive evidence, citing this input and retained observations.")
                    elif arguments.stage == "research":
                        bundle.update(observations=prior["manifest"]["proof"]["execution"]["observations"],
                            nativeTranscript=prior["manifest"]["proof"]["transcript"], probeResult=prior["manifest"]["proof"]["result"],
                            instructions="Compare these verified native observations with R1/H1/H2/H3, distinguishing observed behavior from causal conclusions and conditional contributions. Your interpretation remains ModelDeclared. Cite this input artifact and the Probe result. Do not execute, implement, mutate records or adjudicate the ledger; report findings or honest inconclusive limits for later reviewed planning.")
                    elif arguments.stage == "plan":
                        observed = prior["values"]["artifacts"][prior["manifest"]["proof"]["observations"]["value"]]["body"]
                        bundle.update(observations=observed["observations"], nativeTranscript=observed["nativeTranscript"], investigation=before["views"],
                            probeResult=prior["manifest"]["proof"]["probe"], researchResult=prior["manifest"]["proof"]["result"],
                            instructions=(root / "dev/defect-plan.md").read_text())
                    elif arguments.stage == "integrate":
                        bundle.update(investigation=before["views"], task=intake["task"],
                            instructions=(root / "dev/defect-integrate.md").read_text())
                    elif arguments.stage == "upstream":
                        bundle.update(investigation=before["views"], incorporation=prior["manifest"]["proof"],
                            integration=json.loads((original / "integrations.json").read_text()),
                            instructions=(root / "dev/defect-upstream.md").read_text())
                    else:
                        assessment = runpy.run_path(str(root / "dev/defect-assess-evidence.py"))
                        prepared = assessment["inputs"](prior, arguments.experiments.resolve(), (root / "dev/defect-assessment.md").read_text())
                        bundle = prepared["bundle"]
                    body = json.dumps(bundle, ensure_ascii=False, separators=(",", ":"))
                    assert len(body.encode()) <= 128 * 1024
                    (evidence / "empirical-input.json").write_text(body)
                    upload = {"project": project, "id": {"value": str(uuid.uuid4())}, "attempt": prior["values"]["run"]["attempt"]["id"], "kind": "Input", "mediaType": "application/json", "body": body}
                    publication = urllib.request.Request(checks.environment["CQ_ORIGIN"] + "/api/artifact", data=json.dumps(upload).encode(), headers={
                        "Authorization": "Bearer " + checks.environment["CQ_TOKEN"], "CQ-Session": checks.environment["CQ_SESSION"], "CQ-Protocol-Version": "0.1.0", "Content-Type": "application/json"})
                    with urllib.request.urlopen(publication, timeout=15) as response:
                        metadata = json.loads(response.read(32768))
                    assert metadata["id"] == upload["id"] and metadata["sha256"] == hashlib.sha256(body.encode()).hexdigest() and metadata["actor"]["role"] == "Human"
                    write(evidence / "bundle-publication.json", metadata)
                    context = [upload["id"]]
                    if arguments.stage == "research":
                        context.append(prior["manifest"]["proof"]["result"])
                    request = ("Advance only the supplied empirical assignment through Explore. Preserve every ledger record/revision/history and the fixture Git state: intake text about later probes is now actionable, but adjudication and repair belong to later reviewed stages. "
                        "Use Select and StartChoice with the exact supplied roots, ALL guidance and artifact handles. The host supplies the recording/analysis instructions directly to the child through the input artifact; do not read or copy that body. "
                        "Complete this assignment once, forward compact outcomes, release every claim and finish. Do not create records, apply proposals, start Planner/Reviewer/Implement, or infer a completed fix.\n" +
                        json.dumps({"work": {"Worker": {"mode": "Probe"}} if arguments.stage == "probe" else {"Explorer": {"mode": "Research"}},
                            "harness": "Codex" if arguments.stage == "probe" else "Pi", "roots": members, "guidance": guidance, "artifacts": context}))
                    (evidence / "request.txt").write_text(request)
                    workflow = ["--workflow", "advance", "--roots", "D" + intake["defect"]["number"], "--through", "explore"]
                    if arguments.stage == "plan":
                        context += [prior["manifest"]["proof"][key] for key in ["observations", "probe", "result"]]
                        request = ("Advance D1 through Plan only. Intake and empirical exploration are complete; earlier intake-only restrictions are historical. "
                            "Use Codex Planners and independent Pi Plan reviews for every stored proposal before applying it. "
                            "First adjudicate existing R1/H1/H2/H3 from the empirical evidence; preserve their question/claims. "
                            "Then Produce one fix Goal from D1; in a fresh round Produce one Milestone from that Goal; "
                            "finally, in another round, Produce one Task from that Goal assigned to that existing Milestone. No direct ledger changes. "
                            "Pass ALL supplied artifact handles to EVERY Planner and Reviewer; the host materializes the exact instructions, investigation and observations. "
                            "Do not read or copy those bodies. Use current revisions and claims for each round; a failed proposal requires new planning/review. "
                            "Preserve Git, leave D1/Goal/Milestone Open and Task Ready, release all claims. No Worker, implementation or integration.\n" +
                            json.dumps({"root": intake["defect"], "investigation": [{"id": view["item"]["id"], "revision": view["item"]["revision"]} for view in before["views"]], "artifacts": context}))
                        (evidence / "request.txt").write_text(request)
                        workflow[-1] = "plan"
                    if arguments.stage == "integrate":
                        request = ("Advance the single supplied Ready Task through Integrate. The reviewed investigation and plan are complete; earlier intake/plan-only restrictions are historical. "
                            "Use Pi Worker/Implement and independent Codex Reviewer/Candidate. Both must execute the fresh named defect-oracle check on the candidate. "
                            "Use Select/StartChoice and current revisions; pass the supplied Input handle and ALL guidance to each child without reading/copying its body. "
                            "If selection requires Planner assessment, use Codex for assessment only with the same context; no proposals or ledger edits. "
                            "Correct through review handles and repeat independent review as necessary. Integrate the accepted exact candidate using host dispatch; no direct completion edits. "
                            "Only the Task may change to Done. Leave D1, Goal and Milestone Open, preserve all other records/history and release all claims. "
                            "No upstream work in this stage.\n" + json.dumps({"roots": members, "guidance": guidance, "artifacts": context}))
                        (evidence / "request.txt").write_text(request)
                        workflow = ["--workflow", "advance", "--roots", "T" + intake["task"]["number"], "--through", "integrate"]
                    if arguments.stage == "upstream":
                        chain = prior["manifest"]["proof"]["chain"]
                        context += [chain["workerResult"], chain["reviewResult"], *(value["artifact"] for value in chain["validation"])]
                        request = ("Prepare the local synthetic dependency report and reviewed local closeout under upstream Prepare. "
                            "Implementation and integration are verified; earlier stage-only restrictions are historical. "
                            "Use Codex Planners and independent Pi Plan reviewers; every mutation must come from an accepted stored proposal and current claimed revisions. "
                            "Pass ALL supplied artifact handles to every Planner/Reviewer without reading or copying their bodies. "
                            "Execute the supplied four singleton rounds in order. For EVERY Select, including Plan reviews, roots contains ONLY that round's root; "
                            "guidance contains current ItemRevision references for ALL SEVEN other original records listed below. Do not use those context records as roots. "
                            "Do not send empty guidance or assume artifact context replaces it. Re-read current revisions after each application. "
                            "StartChoice must use a singleton choice for the round's root; correct the selection if it has other members. "
                            "Close D1, G1 and M1 in separate reviewed rounds, then Produce the four specified preparation records from G1 in the fourth round. "
                            "The Upstream reproduction field must copy D1's reproduction string exactly, without paraphrasing. "
                            "Preserve T1 and all R/H records/history. No external publication, confirmation or observed-action claim is authorized. "
                            "No Worker or implementation; preserve Git and release claims.\n" + json.dumps({"roundRoots": [intake[key] for key in ["defect", "goal", "milestone", "goal"]],
                                "originalRecords": before["claims"]["members"], "artifacts": context}))
                        (evidence / "request.txt").write_text(request)
                        workflow = ["--workflow", "upstream", "--roots", "D" + intake["defect"]["number"], "--action", "prepare"]
                    if arguments.stage == "assess":
                        context += prepared["handles"]
                        write(evidence / "input-bound.json", assessment["bound"](before, metadata, body, prepared))
                        request = ("Obtain exactly one Codex Reviewer Audit on the current T1 and exact incorporated workspace below. "
                            "Use direct Start with the exact current members, ALL guidance and artifact handles, and previous:null. Acquire their exact claim for at most 300000 ms. "
                            "The host materializes the whole-process rubric and evidence; do not compose a child prompt or read/copy these bodies. "
                            "The reviewer must inspect the entire defect-to-upstream process, every referenced historical revision and every tracked candidate file. "
                            "Audit cannot execute checks; prior host observations are context. No ledger changes, proposals, implementation, integration or external action. "
                            "Release claims after this single review, including ChangesRequested or Blocked, and return its truthful bounded outcome. This is not human acceptance.\n" +
                            json.dumps({"work": {"Reviewer": {"mode": "Audit"}}, "harness": "Codex",
                                "members": [{"id": view["item"]["id"], "revision": view["item"]["revision"]} for view in before["views"] if view["item"]["id"] in members],
                                "guidance": guidance, "artifacts": context, "previous": None}))
                        (evidence / "request.txt").write_text(request)
                        workflow = []
                try:
                    began = time.monotonic()
                    with (evidence / "governor.stdout").open("w") as out, (evidence / "governor.stderr").open("w") as err:
                        finished = subprocess.run(command + ["run", "claude", "--settings", str(evidence / "settings.json"), "--input", str(evidence / "request.txt")] + workflow,
                            cwd=consumer, env=environment, stdout=out, stderr=err, timeout=evaluation["EXECUTION_MILLIS"] / 1000 + 120)
                    result.update(exit=finished.returncode, elapsedSeconds=round(time.monotonic() - began, 3))
                    session, = (evidence / "sessions").iterdir()
                    run = json.loads((session / "run.json").read_text())
                    statuses = [json.loads(path.read_text()) for path in (session / "children").glob("*/receipt.json")]
                    write(evidence / "dispatch-statuses.json", statuses)
                    input_id = {"value": str(uuid.UUID(bytes=hashlib.md5((run["attempt"]["id"]["value"] + ":input").encode()).digest(), version=3))}
                    evaluation["artifacts"](checks.environment, evidence, session, statuses, [input_id])
                    write(evidence / "after.json", snapshot(api, project, consumer, session))
                    if arguments.stage == "integrate":
                        integrations = []
                        for path in (session / "integrations").glob("*.json"):
                            local = json.loads(path.read_text())
                            record = api({"Read": {"input": {"project": project, "selection": {"Integration": {"id": local["intent"]["id"]}}}}})["Integration"]["record"]
                            integrations.append({"local": local, "record": record})
                        write(evidence / "integrations.json", integrations)
                        write(evidence / "target.json", {"value": subprocess.check_output(["git", "-C", str(consumer), "rev-parse", "refs/heads/integration"], text=True).strip()})
                    if arguments.stage == "probe":
                        native = runpy.run_path(str(root / "dev/defect-probe-evidence.py"))
                        transcripts = {}
                        for status in statuses:
                            transcripts.update(native["export"](api, project, session, status["attempt"]))
                        write(evidence / "native-artifacts.json", transcripts)
                finally:
                    primary_failure = sys.exc_info()[0] is not None
                    result["archiveErrors"] = evaluation["archive"](checks, evidence)
                    if result["archiveErrors"] and not primary_failure:
                        raise RuntimeError("; ".join(result["archiveErrors"]))
                values = process["stage_evidence"](evidence)
                total = total_usage()
                write(evidence / "combined-usage-summary.json", total)
                parts = [] if prior is None else [prior["usage"]]
                parts.append(json.loads((evidence / "usage-summary.json").read_text())["UsageSummary"]["report"])
                reconcile(parts, total["UsageSummary"]["report"])
                result.update(accounting="reconciled", observedAttempts=len(values["attempts"]), base=base,
                              dumpSha256=hashlib.sha256((evidence / "cq-database.dump").read_bytes()).hexdigest())
                if prior is not None:
                    assert not set(prior["attemptIds"]) & {value["attempt"]["id"]["value"] for value in values["attempts"]}
                assert finished.returncode == 0, "Defect governing session failed"
                if arguments.stage == "plan":
                    result["proof"] = runpy.run_path(str(root / "dev/defect-plan-evidence.py"))["plan"](evidence, values, settings, prior)
                elif arguments.stage == "integrate":
                    implementation = runpy.run_path(str(root / "dev/defect-integrate-evidence.py"))
                    implementation["execute_original"](evidence, json.loads((evidence / "target.json").read_text()), sys.executable)
                    result["proof"] = implementation["integrate"](evidence, values, settings, prior)
                elif arguments.stage == "upstream":
                    result["proof"] = runpy.run_path(str(root / "dev/defect-upstream-evidence.py"))["upstream"](evidence, values, settings, prior)
                elif arguments.stage == "assess":
                    result["proof"] = assessment["assess"](evidence, values, settings, prior)
                else:
                    result["proof"] = predicates["begin"](values, settings) if prior is None else predicates["empirical"](evidence, values, settings, prior, arguments.stage)
                result["status"] = arguments.stage + "-passed"
                if arguments.stage == "assess":
                    result["status"] = "assess-passed" if result["proof"]["accepted"] else "assess-not-accepted"
                    result["remaining"] = ["matched usage repetitions", "full M4 review", "human acceptance"]
    except BaseException as error:
        result.update(status="failed", error=str(error))
        raise
    finally:
        write(evidence / "result.json", result)
    print(result["status"].upper() + ": full milestone and human acceptance remain pending; evidence", evidence, flush=True)


if __name__ == "__main__":
    main()
