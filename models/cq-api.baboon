model cq.api
version "0.1.0"

root id ProjectId { value: uid }
root id Revision { value: i64 }

root data Probe {
  project: ProjectId
  revision: Revision
  text: str
}

root adt ApiError {
  data InvalidInput { message: str }
  data Unauthorized { message: str }
  data Conflict { expected: Revision actual: Revision }
  data UnsupportedVersion { requested: str supported: lst[str] }
}

root data ProtocolHello {
  version: str
  supported: lst[str]
}

root data InstallationInfo {
  version: str
  schemaSha256: str
  appliedSchemaSha256: str
  postgresMajor: i32
  fsync: bit
  synchronousCommit: str
  fullPageWrites: bit
  source: SourceBuild
  activeClaims: i64
  managedAttempts: i64
  pendingIntegrations: i64
}

enum Ledger { Milestones Ideas Defects Goals Tasks Researches Hypothesis Questions Decisions Reviews Handoffs OperatorActions Memories Upstream }
root data ItemId { project: ProjectId ledger: Ledger number: i64 }
root id SessionId { value: uid }
root id RequestId { value: uid }
root id ClaimId { value: uid }
root id AttemptId { value: uid }
root id AssignmentId { value: uid }
root id ObservationId { value: uid }
root id ArtifactId { value: uid }
root id ChangeCursor { value: i64 }
enum Role { Human Governor Explorer Planner Worker Reviewer Collector }
root data Actor { subject: str session: SessionId role: Role }
root data Provenance { actor: Actor receivedAt: i64 request: RequestId }
root data Project { id: ProjectId name: str revision: Revision createdAt: i64 }
enum BackupTable { Projects Counters Items Labels Edges History Requests Changes Claims ClaimMembers UsageClock UsageAssignments UsageMembers UsageAttempts UsageMeters UsageCosts UsageRecords UsageHeads UsageOutcomes UsageSpans Artifacts ResultAdmissions Integrations IntegrationMembers Worksets Settings Drivers }
root data BackupEntry { table: BackupTable rows: i64 bytes: i64 sha256: str }
root data BackupManifest { project: ProjectId schemaSha256: str postgresMajor: i32 createdAt: i64 entries: lst[BackupEntry] }

enum MilestoneStatus { Open Complete Cancelled }
enum IdeaStatus { Proposed Accepted Declined Withdrawn Implemented }
enum DefectStatus { Open Resolved NotReproducible Rejected Withdrawn }
enum GoalStatus { Open Achieved Abandoned }
enum TaskStatus { Ready Active Done Cancelled }
enum ResearchStatus { Open Active Concluded Inconclusive Cancelled }
enum HypothesisStatus { Proposed Investigating Supported Refuted Inconclusive Withdrawn }
enum QuestionStatus { Open Answered Withdrawn }
enum DecisionStatus { Proposed Adopted Superseded Withdrawn }
enum ReviewStatus { Pending Active Approved ChangesRequested Cancelled }
enum HandoffStatus { Open Accepted Cancelled }
enum OperatorActionStatus { Requested Confirmed Observed Failed Cancelled }
enum MemoryStatus { Current Superseded Retracted }
enum UpstreamStatus { Identified Reported Resolved Declined Withdrawn }
enum Severity { Low Medium High Critical }
enum EvidenceOrigin { ModelDeclared HostObserved HumanReported }
root adt Citation {
  data Url { address: str }
  data Artifact { id: ArtifactId }
  data Commit { repository: str hash: str }
  data File { path: str revision: opt[str] }
}
root data Evidence { description: str origin: EvidenceOrigin citations: lst[Citation] }
root data ReviewedItem { item: ItemId revision: Revision }
root data QuestionRecommendation { alternative: i32 reason: str }
root adt Content {
  data Milestone { status: MilestoneStatus objective: str }
  data Idea { status: IdeaStatus outcome: str motivation: str }
  data Defect { status: DefectStatus severity: Severity observed: str expected: str reproduction: str cause: opt[str] resolution: lst[Evidence] }
  data Goal { status: GoalStatus outcome: str acceptance: lst[str] scope: str }
  data Task { status: TaskStatus acceptance: lst[str] result: opt[str] validation: lst[Evidence] }
  data Research { status: ResearchStatus question: str findings: lst[Evidence] conclusion: opt[str] recommendation: opt[str] }
  data Hypothesis { status: HypothesisStatus claim: str rationale: str evidence: lst[Evidence] adjudication: opt[str] }
  data Question { status: QuestionStatus prompt: str context: str alternatives: lst[str] recommendation: opt[QuestionRecommendation] answer: opt[str] }
  data Decision { status: DecisionStatus choice: str rationale: str alternatives: lst[str] }
  data Review { status: ReviewStatus subjects: lst[ReviewedItem] candidate: opt[Citation.Commit] findings: lst[Evidence] summary: opt[str] }
  data Handoff { status: HandoffStatus outcome: str remaining: lst[str] blockers: lst[str] }
  data OperatorAction { status: OperatorActionStatus action: str expectedEvidence: str confirmation: opt[str] observedEvidence: lst[Evidence] }
  data Memory { status: MemoryStatus knowledge: str applicability: str evidence: lst[Evidence] }
  data Upstream { status: UpstreamStatus component: str version: str reproduction: str report: opt[Citation.Url] outcome: opt[str] }
}
root data ItemDraft { title: str body: str labels: set[str] archived: bit content: Content citations: lst[Citation] }
root data Item { id: ItemId revision: Revision draft: ItemDraft createdAt: i64 updatedAt: i64 provenance: Provenance }
enum Relation { DerivedFrom Produces PartOf Contains BlockedBy Blocks Reviews ReviewedBy Supports SupportedBy Contradicts ContradictedBy Supersedes SupersededBy RelatesTo }
root data ItemRef { relation: Relation target: ItemId }
root data ItemView { item: Item refs: lst[ItemRef] }
root data ItemViews { items: lst[ItemView] omitted: lst[ItemRevision] }
root data HistoryEntry { item: ItemView cursor: ChangeCursor reason: str schemaVersion: str }
root data Fence { claim: ClaimId generation: i64 }
root data ClaimSnapshot { cursor: ChangeCursor digest: str }
root adt ClaimOrigin {
  data Acquire { durationMillis: i64 }
  data Takeover { actor: Actor snapshot: ClaimSnapshot durationMillis: i64 }
}
root data Claim { fence: Fence owner: Actor members: set[ItemId] expiresAt: i64 released: bit origin: ClaimOrigin }
root data ClaimPreview { members: lst[ItemRevision] claims: lst[Claim] integrations: lst[IntegrationHold] snapshot: ClaimSnapshot }
enum TerminationIntent { Cancel Complete }
root adt TerminalStatus {
  data Milestone { value: MilestoneStatus }
  data Idea { value: IdeaStatus }
  data Defect { value: DefectStatus }
  data Goal { value: GoalStatus }
  data Task { value: TaskStatus }
  data Research { value: ResearchStatus }
  data Hypothesis { value: HypothesisStatus }
  data Question { value: QuestionStatus }
  data Decision { value: DecisionStatus }
  data Review { value: ReviewStatus }
  data Handoff { value: HandoffStatus }
  data OperatorAction { value: OperatorActionStatus }
  data Memory { value: MemoryStatus }
  data Upstream { value: UpstreamStatus }
}
root adt TerminationExclusion {
  data Context { source: ItemId relation: Relation }
  data Shared { producer: ItemId }
  data Prerequisite { consumer: ItemId }
  data ExcludedBranch {}
}
root adt TerminationEffect {
  data Change { status: TerminalStatus }
  data Preserve {}
  data Excluded { reasons: lst[TerminationExclusion] }
  data Unsupported { message: str }
}
root data TerminationEntry { item: ItemSummary effect: TerminationEffect }
root data TerminationClaim { fence: Fence owner: Actor members: lst[ItemId] affected: lst[ItemId] permitted: bit }
root data TerminationPlan { roots: lst[ItemId] intent: TerminationIntent entries: lst[TerminationEntry] claims: lst[TerminationClaim] integrations: lst[IntegrationHold] canApply: bit }
root data TerminationSnapshot { cursor: ChangeCursor digest: str }
root data TerminationPreview { plan: TerminationPlan snapshot: TerminationSnapshot }
root data ArchiveRetention { item: ItemSummary open: lst[ItemId] }
root data ArchivePlan { members: lst[ItemSummary] retained: lst[ArchiveRetention] scanned: i32 limited: bit cursor: ChangeCursor }
root adt MilestoneRef {
  data Existing { id: ItemId }
  data Created { mutation: i32 }
}
root adt Mutation {
  data Archive { members: lst[ItemRevision] }
  data Produce { producer: ItemId expected: Revision drafts: lst[ItemDraft] milestone: opt[MilestoneRef] }
  data Terminate { roots: set[ItemId] intent: TerminationIntent snapshot: TerminationSnapshot }
  data Create { draft: ItemDraft }
  data Replace { id: ItemId expected: Revision draft: ItemDraft }
  data Reference { source: ItemId expectedSource: Revision relation: Relation target: ItemId expectedTarget: Revision present: bit }
  data Restore { id: ItemId expected: Revision historical: Revision neighbors: lst[ItemRevision] }
}
root data BrowserDraft { project: ProjectId item: opt[ItemRevision] value: ItemDraft pending: opt[ChangeRequest] }
root data ChangeRequest { request: RequestId mutations: lst[Mutation] fences: lst[Fence] reason: str }
root data ItemRevision { id: ItemId revision: Revision }
root data ChangeAck { request: RequestId cursor: ChangeCursor items: lst[ItemRevision] }
root data ChangeEvent { cursor: ChangeCursor request: RequestId items: lst[ItemRevision] }
root data ChangePage { cursor: ChangeCursor events: lst[ChangeEvent] hasMore: bit }
enum ArchiveFilter { Active Archived All }
root data QuerySpan { start: i32 end: i32 }
root data QueryDiagnostic { span: QuerySpan message: str }
root data QueryItem { ledger: Ledger number: i64 }
enum QuerySuggestionKind { Field Relation Operator Value Item }
root data QuerySuggestion { kind: QuerySuggestionKind span: QuerySpan text: str label: str }
root data QueryAnalysis { diagnostic: opt[QueryDiagnostic] suggestions: lst[QuerySuggestion] hasMore: bit }
root adt QueryExpression {
  data All {}
  data Text { words: lst[str] phrase: bit }
  data Id { item: QueryItem }
  data LedgerIs { ledger: Ledger }
  data Status { value: str }
  data Tag { value: str }
  data Project { id: ProjectId }
  data Archive { value: ArchiveFilter }
  data Reference { relation: Relation item: QueryItem }
  data Working {}
  data Not { expression: QueryExpression }
  data And { left: QueryExpression right: QueryExpression }
  data Or { left: QueryExpression right: QueryExpression }
}
root data ItemOutcome { terminal: bit satisfiesDependency: bit }
root data ItemSummary { id: ItemId revision: Revision title: str status: str archived: bit labels: set[str] updatedAt: i64 outcome: ItemOutcome }
root data ItemPage { items: lst[ItemSummary] cursor: ChangeCursor after: opt[ItemId] hasMore: bit }
enum WorksetRole { Selected Context }
root adt WorksetReason {
  data Archived {}
  data Terminal {}
  data Settled {}
  data Blocked { prerequisite: ItemId }
  data Shared { producer: ItemId }
  data Context { source: ItemId relation: Relation }
}
root data WorksetEntry { item: ItemSummary role: WorksetRole root: bit ready: bit reasons: lst[WorksetReason] }
root data WorksetSnapshot { cursor: ChangeCursor rootsHash: str }
root data WorksetPage { entries: lst[WorksetEntry] snapshot: WorksetSnapshot after: opt[ItemId] hasMore: bit selectedCount: i32 contextCount: i32 readyCount: i32 }
root data HistoryPage { entries: lst[HistoryEntry] hasMore: bit }
root adt Fault {
  data IntegrationPending { id: IntegrationId }
  data Invalid { message: str }
  data QuerySyntax { diagnostic: QueryDiagnostic }
  data Denied { message: str }
  data Missing { message: str }
  data Conflict { message: str }
  data StaleFence { message: str }
  data Resync { message: str }
  data Limit { message: str }
}

enum Harness { Claude Codex Pi }
enum AttemptState { Running Completed Failed Cancelled Unknown Abstained }
enum Attribution { Direct Shared Unattributed }
root data EvaluationScope { run: str scenario: str assessor: bit }
root data Assignment { id: AssignmentId project: ProjectId members: set[ItemId] attribution: Attribution cohort: opt[uid] evaluation: opt[EvaluationScope] }
enum UsagePhase { Govern Explore Probe Plan Work Check Review Combine Integrate }
root data Attempt { id: AttemptId assignment: AssignmentId parent: opt[AttemptId] session: SessionId role: Role harness: Harness provider: str model: str collector: str startedAt: i64 phase: UsagePhase }
enum CounterScope { Increment Cumulative }
enum Measurement { Observed Estimated Missing Unsupported }
root data Counter { value: opt[i64] measurement: Measurement }
root data TokenCounts { input: Counter output: Counter cacheRead: Counter cacheWrite: Counter reasoning: Counter }
enum CostBasis { ProviderEstimate PriceTable ActualBilling Unknown }
root id DecimalAmount { value: str }
root data Money { amount: opt[DecimalAmount] currency: opt[str] basis: CostBasis pricingVersion: opt[str] }
enum UsageCompleteness { Partial Complete Unavailable }
root data UsageObservation {
  id: ObservationId
  attempt: AttemptId
  source: str
  position: i64
  occurredAt: i64
  receivedAt: i64
  scope: CounterScope
  counters: TokenCounts
  inputIncludesCache: bit
  outputIncludesReasoning: bit
  cost: Money
  completeness: UsageCompleteness
  gaps: lst[str]
  evidence: opt[ArtifactId]
  supersedes: opt[ObservationId]
}

root data UsageMeter { key: str attempt: AttemptId scope: CounterScope baseline: TokenCounts baselineCost: Money }
enum UsageDisposition { Contribution Detail }
root data UsageUpload { observation: UsageObservation meter: str disposition: UsageDisposition detailReason: opt[str] }
root data UsageReceipt { id: ObservationId sequence: i64 }
root data RecordedUsage { upload: UsageUpload normalized: TokenCounts actor: Actor sequence: i64 }
root data AttemptOutcome { request: RequestId attempt: AttemptId state: AttemptState finishedAt: i64 gaps: lst[str] supersedes: opt[RequestId] }
root data RecordedOutcome { value: AttemptOutcome actor: Actor receivedAt: i64 sequence: i64 }
root data AttemptCoverage { running: i64 open: i64 unknown: i64 withGaps: i64 }
root data AttemptView { assignment: Assignment attempt: Attempt outcome: opt[RecordedOutcome] observed: bit }
root data AttemptPage { entries: lst[AttemptView] after: opt[AttemptId] hasMore: bit cursor: i64 }
root data OutcomePage { entries: lst[RecordedOutcome] after: i64 hasMore: bit cursor: i64 }
root data MetricTotal { known: i64 unknown: i64 estimated: i64 }
root data CostGroup { attribution: Attribution currency: str basis: CostBasis pricingVersion: opt[str] }
root data CostTotal { group: CostGroup amount: DecimalAmount measurements: i64 }
root data CostPage { entries: lst[CostTotal] after: opt[CostGroup] hasMore: bit cursor: i64 }
root data UsageTotals {
  input: MetricTotal
  output: MetricTotal
  cacheRead: MetricTotal
  cacheWrite: MetricTotal
  reasoning: MetricTotal
  total: MetricTotal
  unknownCosts: i64
}
root data MeterProjection { totals: UsageTotals latestPosition: opt[i64] incompleteSamples: i64 completeness: UsageCompleteness gaps: lst[str] }
root data MeterView { assignment: Assignment attempt: Attempt meter: UsageMeter projection: MeterProjection }
root adt UsageFilter {
  data ProjectAll {}
  data TaskOnly { item: ItemId }
  data CohortOnly { execution: uid }
  data SessionOnly { id: SessionId }
  data EvaluationOnly { run: str scenario: opt[str] }
}
root data UsageReport {
  direct: UsageTotals
  shared: UsageTotals
  unattributed: UsageTotals
  sharedAssignments: lst[Assignment]
  sharedAssignmentsTruncated: bit
  cursor: i64
  incompleteMeters: i64
  attemptsWithoutMeters: i64
  attempts: AttemptCoverage
  costs: CostPage
}
root data UsagePage { entries: lst[RecordedUsage] after: i64 hasMore: bit cursor: i64 }
root data PhaseSpan { id: RequestId assignment: AssignmentId session: SessionId phase: UsagePhase startedAt: i64 finishedAt: i64 state: AttemptState }
root data PhaseUsage { phase: UsagePhase attempts: i64 spans: i64 running: i64 open: i64 wallMillis: i64 totals: UsageTotals costs: lst[CostTotal] }
root data PhaseReport { phases: lst[PhaseUsage] costsTruncated: bit cursor: i64 }

root id CatalogueCursor { value: i64 }
root data ProjectPage { projects: lst[Project] after: opt[ProjectId] hasMore: bit cursor: CatalogueCursor }
root data ProjectConfig { project: ProjectId endpoint: str name: str }
root adt ProjectSetting {
  data Requirements { text: str }
  // The process mode of the project. `selfReviewWithoutChecks` lets a self-reviewed integration proceed in a project that configures no check.
  data Mode { value: ProcessMode selfReviewWithoutChecks: bit }
  data Agents { text: str }
}
root data RequirementsChange { actor: Actor at: i64 }
root data ProjectRequirements { project: ProjectId revision: Revision text: str change: opt[RequirementsChange] }
root adt RequirementsAction {
  data Read {}
  data Replace { expected: Revision text: str }
}
root data RequirementsInput { project: ProjectId action: RequirementsAction }
// How strictly a project's work follows the process: the prescribed order with a Planner and plan review, the same safeguards with the
// Governor planning itself, or additionally the Governor implementing and reviewing itself.
enum ProcessMode { Rigorous CrossCutting Yolo }
root data ModeChange { actor: Actor at: i64 }
root data ProjectMode { project: ProjectId revision: Revision mode: ProcessMode selfReviewWithoutChecks: bit change: opt[ModeChange] }
root adt ModeAction {
  data Read {}
  data Replace { expected: Revision mode: ProcessMode selfReviewWithoutChecks: bit }
}
root data ModeInput { project: ProjectId action: ModeAction }
// What Help and the mode dialog show of one mode. `unavailable` says why the mode cannot be selected in this release.
root data CatalogMode { mode: ProcessMode label: str hint: str description: str instructions: CatalogPrompt unavailable: opt[str] }
root data SearchInput { project: ProjectId query: str after: opt[ItemId] snapshot: opt[ChangeCursor] limit: i32 }
enum ItemOrderField { Id Type Title Status Severity Modified }
enum SortDirection { Ascending Descending }
root data ItemOrder { field: ItemOrderField direction: SortDirection grouped: bit }
root data WorkAttempt { role: Role harness: Harness startedAt: i64 }
root data ItemWork { claim: ClaimId owner: Actor members: i32 expiresAt: i64 attempt: opt[WorkAttempt] }
root data BrowseItem { summary: ItemSummary severity: opt[Severity] milestone: opt[ItemId] work: opt[ItemWork] }
root data BrowsePage { items: lst[BrowseItem] cursor: ChangeCursor after: opt[ItemId] hasMore: bit work: i64 }
root data LedgerCount { ledger: Ledger count: i64 }
root data LedgerCounts { entries: lst[LedgerCount] cursor: ChangeCursor }
root data GraphInput { project: ProjectId roots: set[ItemId] after: opt[ItemId] snapshot: opt[WorksetSnapshot] limit: i32 }
root id WorksetId { value: uid }
root data StoredWorkset { id: WorksetId targets: set[ItemId] through: WorkflowPhase actor: Actor createdAt: i64 }
root data StoredWorksetPage { entries: lst[StoredWorkset] after: opt[WorksetId] hasMore: bit }
root adt WorksetTarget {
  data Stored { id: WorksetId }
  data Inline { targets: set[ItemId] through: WorkflowPhase }
}
root data WorksetMember { item: ItemSummary root: bit }
root data WorksetContextItem { item: ItemSummary reasons: lst[WorksetReason] }
root data WorksetReadiness { item: ItemId ready: bit reasons: lst[WorksetReason] }
root data WorksetPreview {
  workset: opt[WorksetId] targets: set[ItemId] through: WorkflowPhase snapshot: WorksetSnapshot
  advanceable: lst[WorksetMember] context: lst[WorksetContextItem] readiness: lst[WorksetReadiness]
}
root adt SubgraphExtent {
  data Measured { descendants: i32 ready: i32 context: i32 ledgers: lst[LedgerCount] }
  data Oversized { limit: i32 }
}
root data Subgraph { root: ItemSummary extent: SubgraphExtent }
root data SubgraphPage { entries: lst[Subgraph] cursor: ChangeCursor after: opt[ItemId] hasMore: bit }
root adt WorksetAction {
  data BrowseSaved { after: opt[WorksetId] limit: i32 }
  data Discover { after: opt[ItemId] snapshot: opt[ChangeCursor] limit: i32 }
  data Create { targets: set[ItemId] through: WorkflowPhase }
  data Lookup { id: WorksetId }
  data Preview { target: WorksetTarget }
  data StorePreview { preview: WorksetPreview }
}
root data WorksetInput { project: ProjectId action: WorksetAction }
root id CycleId { value: uid }
root id DriverToken { value: uid }
root data DriverKey { harness: Harness session: str }
enum DriverOrigin { UserPromptSubmit Stop Extension StatusLine }
enum DriverState { Binding On Off }
enum DriverStop { Quiescent UserInputRequired LimitReached NotBound Failure Parked Off RestoredArchive }
root data DriverStopped { reason: DriverStop detail: str }
enum CycleState { Pending Active Ended }
root adt CycleToken {
  data Start { token: DriverToken }
  data Resume { token: DriverToken }
}
root adt LineageMember {
  data Run { id: RequestId }
  data Session { id: SessionId }
  data Request { id: RequestId }
  data Attempt { id: AttemptId }
  data Claim { id: ClaimId }
  data Proposal { id: ArtifactId }
  data Change { id: RequestId }
  data Integration { id: IntegrationId }
  data Combination { id: RequestId }
}
root data LineageEntry { member: LineageMember parent: opt[LineageMember] settled: bit }
enum ChildEnd { Admitted Retryable Repeated Failed Cancelled Unknown Abstained }
root data ChildOutcome { attempt: AttemptId members: lst[ItemId] end: ChildEnd input: opt[str] fault: opt[str] }
root data DriverCycle {
  id: CycleId number: i32 state: CycleState roots: set[ItemId] through: WorkflowPhase snapshot: WorksetSnapshot
  advanceable: lst[ItemRevision] run: opt[RequestId] created: lst[ItemId] lineage: lst[LineageEntry]
}
root data DriverStatus {
  key: DriverKey state: DriverState attached: opt[SessionId] workset: opt[WorksetId] targets: set[ItemId] through: WorkflowPhase
  cycle: opt[DriverCycle] activeChildren: i32 directives: i32 stopped: opt[DriverStopped] line: str
}
root data BindOffer { token: DriverToken expiresAt: i64 }
root data CycleRecord {
  id: CycleId number: i32 roots: set[ItemId] through: WorkflowPhase snapshot: WorksetPreview state: CycleState
  startToken: opt[DriverToken] resumeToken: opt[DriverToken] resumed: map[DriverToken, RequestId] run: opt[RequestId]
  created: lst[ItemId] lineage: lst[LineageEntry] resting: set[LineageMember] prompted: set[LineageMember]
  outcomes: lst[ChildOutcome] retried: lst[ChildOutcome]
}
root data DriverRecord {
  project: ProjectId key: DriverKey state: DriverState attached: opt[SessionId] workset: opt[WorksetId]
  targets: set[ItemId] through: WorkflowPhase bind: opt[BindOffer] cycle: opt[CycleRecord]
  directives: i32 stopped: opt[DriverStopped] announced: bit touchedAt: i64 carried: map[SessionId, set[IntegrationId]]
  revision: Revision stoppedAt: opt[i64]
}
root data DriverSummary {
  key: DriverKey state: DriverState attached: opt[SessionId] workset: opt[WorksetId] targets: set[ItemId] through: WorkflowPhase
  cycle: opt[CycleId] activeChildren: i32 stopped: opt[DriverStopped] touchedAt: i64 stoppedAt: opt[i64] revision: Revision
}
root data DriverDirective { cycle: CycleId token: CycleToken text: str }
root adt DriverControl {
  data Start { target: WorksetTarget attached: opt[SessionId] }
  data Park {}
  // `waiting`: the caller has checked that the session will be woken when work in flight ends, and accepts Waiting for it.
  data Continue { waiting: bit }
  data Status {}
}
root adt DriverSession {
  data Bind { token: DriverToken }
  data Status {}
  data Settleable {}
  data Activate { run: RequestId request: WorkflowRequest token: opt[CycleToken] }
  data Inherit { cycle: CycleId parent: LineageMember member: LineageMember }
  data Settle { cycle: CycleId member: LineageMember }
  data Conclude { cycle: CycleId outcome: ChildOutcome }
  data Rest { cycle: CycleId member: LineageMember }
  data Fail { cycle: CycleId member: LineageMember detail: str }
  data Change { cycle: CycleId request: ChangeRequest }
}
root adt DriverRequest {
  data Control { key: DriverKey origin: DriverOrigin action: DriverControl }
  data Session { action: DriverSession }
  data Summaries {}
  data Park { key: DriverKey expected: Revision }
  data Snapshot { key: DriverKey expected: Revision }
}
root data DriverInput { project: ProjectId request: DriverRequest }
root adt DriverActivation {
  data Undriven {}
  data Started { cycle: CycleId }
  data Resumed { cycle: CycleId run: RequestId }
}
root adt DriverReply {
  data Started { status: DriverStatus preview: WorksetPreview bind: opt[DriverToken] message: str }
  data Parked { status: opt[DriverStatus] message: str }
  data Continue { directive: DriverDirective status: DriverStatus messages: lst[str] }
  data Stop { stopped: DriverStopped status: opt[DriverStatus] messages: lst[str] }
  // The cycle's run is still active and the session is woken when its work ends: no directive is issued and the drive stays on.
  data Waiting { status: DriverStatus message: str }
  data Status { value: opt[DriverStatus] }
  data Bound { status: DriverStatus message: str }
  data Activation { value: DriverActivation }
  data Lineage { cycle: CycleId entry: LineageEntry }
  data Changed { cycle: CycleId ack: ChangeAck }
  data Settleable { pending: bit integrations: set[IntegrationId] }
  data Listed { drivers: lst[DriverSummary] }
  data Snapshot { preview: WorksetPreview outcomes: lst[ChildOutcome] }
}
root adt ExtensionDriver {
  data Start { session: str input: str }
  data Park { session: str }
  data Continue { session: str waiting: bit }
  data Status { session: str }
}
root adt ReadSelection {
  data Browse { query: str order: ItemOrder after: opt[ItemId] snapshot: opt[ChangeCursor] limit: i32 }
  data Counts {}
  data Proposal { id: ArtifactId }
  data Integration { id: IntegrationId }
  data Admission { attempt: AttemptId }
  data Claims { members: set[ItemId] }
  data Termination { roots: set[ItemId] intent: TerminationIntent }
  data ArchivePreview { query: str limit: i32 }
  data QueryComplete { query: str cursor: i32 limit: i32 }
  data ArtifactInfo { id: ArtifactId }
  data ArtifactText { id: ArtifactId offset: i32 limit: i32 }
  data ItemDetail { id: ItemId }
  data ItemDetails { members: lst[ItemRevision] bytes: i32 }
  data History { id: ItemId before: Revision limit: i32 }
  data Changes { after: ChangeCursor limit: i32 }
  data Catalog {}
  data WorksetBrowse { query: str order: ItemOrder after: opt[ItemId] snapshot: opt[ChangeCursor] limit: i32 workset: WorksetId }
}
root data ReadInput { project: ProjectId selection: ReadSelection }
root data ChangeInput { project: ProjectId change: ChangeRequest }
root data ProposalApplyInput { project: ProjectId result: ArtifactId }
root adt ClaimAction {
  data Takeover { id: ClaimId owner: Actor members: set[ItemId] durationMillis: i64 snapshot: ClaimSnapshot }
  data Acquire { id: ClaimId members: set[ItemId] durationMillis: i64 }
  data Renew { fence: Fence durationMillis: i64 }
  data Release { fence: Fence }
}
root data ClaimInput { project: ProjectId action: ClaimAction }
root adt UsageSelection {
  data Summary { filter: UsageFilter }
  data Costs { filter: UsageFilter after: opt[CostGroup] snapshot: opt[i64] limit: i32 }
  data Audit { filter: UsageFilter after: i64 limit: i32 }
  data Attempts { filter: UsageFilter after: opt[AttemptId] snapshot: opt[i64] limit: i32 }
  data Outcomes { attempt: AttemptId after: i64 limit: i32 }
  data Phases { filter: UsageFilter }
}
root data UsageInput { project: ProjectId selection: UsageSelection }
root adt Command {
  data Projects { after: opt[ProjectId] snapshot: opt[CatalogueCursor] limit: i32 }
  data Initialize { config: ProjectConfig }
  data RenameProject { project: ProjectId expected: Revision name: str }
  data Requirements { input: RequirementsInput }
  data Mode { input: ModeInput }
  data Agents { input: AgentsInput }
  data Search { input: SearchInput }
  data Graph { input: GraphInput }
  data Workset { input: WorksetInput }
  data Driver { input: DriverInput }
  data Read { input: ReadInput }
  data Change { input: ChangeInput }
  data ApplyProposal { input: ProposalApplyInput }
  data ClaimWork { input: ClaimInput }
  data Usage { input: UsageInput }
}
root adt Result {
  data Browsed { page: BrowsePage }
  data Counts { report: LedgerCounts }
  data Details { page: ItemViews }
  data Proposal { preview: ProposalPreview }
  data Integration { record: IntegrationRecord }
  data Admission { record: ResultAdmission }
  data Claims { preview: ClaimPreview }
  data Termination { preview: TerminationPreview }
  data ArchivePreview { plan: ArchivePlan }
  data Workset { page: WorksetPage }
  data Subgraphs { page: SubgraphPage }
  data WorksetStored { workset: StoredWorkset }
  data WorksetsListed { page: StoredWorksetPage }
  data WorksetPreviewed { preview: WorksetPreview }
  data Driver { reply: DriverReply }
  data QueryAnalyzed { analysis: QueryAnalysis }
  data ArtifactInfo { metadata: ArtifactMetadata }
  data ArtifactText { page: ArtifactPage }
  data Projects { page: ProjectPage }
  data Initialized { project: Project }
  data Requirements { value: ProjectRequirements }
  data Mode { value: ProjectMode }
  data Agents { value: AgentsView }
  data AgentRoute { value: ResolvedAssignment }
  data Found { page: ItemPage }
  data Detail { view: ItemView }
  data History { page: HistoryPage }
  data Changes { page: ChangePage }
  data Changed { ack: ChangeAck }
  data Claimed { claim: Claim }
  data UsageSummary { report: UsageReport }
  data UsageCosts { page: CostPage }
  data UsageAudit { page: UsagePage }
  data UsageAttempts { page: AttemptPage }
  data UsageOutcomes { page: OutcomePage }
  data UsagePhases { report: PhaseReport }
  data Catalog { value: HelpCatalog }
  data Failed { fault: Fault }
}
root adt HostUsage {
  data Assign { value: Assignment }
  data Start { value: Attempt }
  data Meter { value: UsageMeter }
  data Ingest { value: UsageUpload }
  data Finish { value: AttemptOutcome }
  data Span { value: PhaseSpan }
}
root data HostUsageInput { project: ProjectId operation: HostUsage }
root adt HostUsageResult {
  data Assigned { value: Assignment }
  data Started { value: Attempt }
  data Metered { value: UsageMeter }
  data Ingested { value: UsageReceipt }
  data Finished { value: AttemptOutcome }
  data Spanned { value: PhaseSpan }
}
root data GrantRequest { project: ProjectId actor: Actor expiresAt: i64 }
root adt Credential {
  data RootSession { session: SessionId expiresAt: i64 }
  data Scoped { grant: GrantRequest }
}
root data AccessToken { value: str expiresAt: i64 }
root data LiveScope { catalogue: bit project: opt[ProjectId] }
root data ProjectCursors { project: ProjectId items: ChangeCursor usage: i64 work: i64 }
root data LiveRevision { catalogue: opt[CatalogueCursor] project: opt[ProjectCursors] }
root adt ClientFrame {
  data Call { id: RequestId command: Command }
  data Watch { id: RequestId scope: LiveScope }
  data Ping { nonce: str }
  data Pong { nonce: str }
}
root adt ServerFrame {
  data Reply { id: RequestId result: Result }
  data Updated { subscription: RequestId revision: LiveRevision }
  data Resync { subscription: RequestId fault: Fault }
  data Ping { nonce: str }
  data Pong { nonce: str }
}

root id GitCommit { value: str }
root data WorkspaceSpec { project: ProjectId owner: SessionId attempt: AttemptId repository: str base: GitCommit }
enum WorkspaceAdmission { Open Quarantined Removed }
root data WorkspaceObservation { head: GitCommit gitCommon: str gitDirectory: str verifiedAt: i64 }
root data WorkspaceRecord { spec: WorkspaceSpec directory: str admission: WorkspaceAdmission observed: opt[WorkspaceObservation] quarantineReason: opt[str] }
root data RetainedWorkspace { attempt: AttemptId reason: str }
root data SessionCleanup {
  session: SessionId removed: lst[AttemptId] quarantined: lst[RetainedWorkspace] retained: lst[RetainedWorkspace]
  acknowledged: i32 problem: opt[str]
}
root data CleanupTotals {
  examined: i32 live: i32 recovered: i32 abandoned: i32 removed: i32 quarantined: i32 retained: i32 acknowledged: i32 problems: i32 unexamined: i32
}
root data WorkspaceCleanupReceipt {
  owner: SessionId startedAt: i64 finishedAt: i64 deadlineExceeded: bit
  live: lst[SessionId] sessions: lst[SessionCleanup] totals: CleanupTotals
}
enum RecoveryOutcome { Recovered Abandoned }
adt SourceBuild {
  data Clean { revision: GitCommit }
  data Modified { revision: GitCommit }
  data Undetermined { reason: str }
}
root data SessionRecovery { outcome: RecoveryOutcome reason: str recordedAt: i64 host: str build: SourceBuild }

// Agent model configuration (I17). The stored form of a layer is the text its operator wrote (ProjectSetting.Agents,
// InstallationSetting.Agents); AgentConfig is what that text parses to and is never stored.
enum AgentRole { Planner Worker Explorer Reviewer }
enum ModelTier { Frontier Standard Fast }
enum Effort { Off Minimal Low Medium High XHigh Max }
root data ModelName { provider: opt[str] model: str }
root data TierEntry { model: ModelName effort: opt[Effort] }
root adt HarnessSelector {
  data Governing {}
  data Named { harness: Harness }
}
root adt ModelTarget {
  data Exact { model: ModelName }
  data Tier { value: ModelTier }
}
root data ModelReference { harness: HarnessSelector target: ModelTarget effort: opt[Effort] }
enum SeatStrategy { Fallback RoundRobin First }
root adt SeatChoice {
  data Single { reference: ModelReference }
  data Strategy { kind: SeatStrategy entries: lst[ModelReference] }
}
enum PanelMode { All Any }
root adt RoleChoice {
  data Seat { choice: SeatChoice }
  data Panel { mode: PanelMode seats: lst[SeatChoice] min: i32 }
}
root data HarnessAgents { tiers: map[ModelTier, lst[TierEntry]] roles: map[AgentRole, RoleChoice] }
root data AgentConfig { defaults: map[AgentRole, RoleChoice] harnesses: map[Harness, HarnessAgents] }
root data ModelRoute { harness: Harness provider: opt[str] model: str effort: opt[Effort] }
root data ResolvedSeat { strategy: SeatStrategy candidates: lst[ModelRoute] }
enum AgentLayer { Project Installation }
enum RoleSource { HarnessRoles DefaultRoles }
// Where the lookup found a role: the layer and the part of its document.
root data RoleOrigin { layer: AgentLayer source: RoleSource }
// selfReview: the indices of the seats of a Reviewer role that hold a candidate of the governing harness.
root data ResolvedRole { mode: PanelMode min: i32 seats: lst[ResolvedSeat] origin: RoleOrigin selfReview: lst[i32] }
// Line and column are 1-based; a column counts UTF-16 code units.
root data TextPosition { line: i32 column: i32 }
root adt AgentProblem {
  data Syntax { at: TextPosition message: str }
  data UnknownKey { at: TextPosition key: str }
  data EmptyList { at: TextPosition }
  data InvalidMinimum { at: TextPosition min: i32 seats: i32 }
  data PanelNotAllowed { at: TextPosition role: AgentRole }
  data ProviderRequired { at: TextPosition harness: Harness }
  data ProviderNotAllowed { at: TextPosition harness: Harness }
  data EffortUnsupported { at: TextPosition harness: Harness effort: Effort }
  data RoleUnassigned { harness: Harness role: AgentRole }
  data TierUndefined { harness: Harness tier: ModelTier role: AgentRole }
}
root adt RoleResolution {
  data Resolved { plan: ResolvedRole }
  // The positions in the problems are those of the text of the origin's layer; a role that no layer assigns has no origin.
  data Unresolved { origin: opt[RoleOrigin] problems: lst[AgentProblem] }
}
root data ResolvedAssignment { harness: Harness role: AgentRole resolution: RoleResolution }
root adt InstallationSetting {
  data Agents { text: str }
}
root adt AgentsScope {
  data Installation {}
  data Project {}
}
root adt AgentsAction {
  data Read {}
  data Replace { scope: AgentsScope expected: Revision text: str }
  // The unsaved text of one layer against the other layer as stored.
  data Preview { scope: AgentsScope text: str }
  data Resolve { harness: Harness role: AgentRole }
}
root data AgentsInput { project: ProjectId action: AgentsAction }
root data AgentsDocument { revision: Revision text: str change: opt[RequirementsChange] problems: lst[AgentProblem] }
root data AgentsView { installation: AgentsDocument project: AgentsDocument assignments: lst[ResolvedAssignment] }
// A unit is one started choice; it owns the attempts of its seats and their candidates.
root adt SeatEnd {
  data Pending {}
  data Delivered { result: ArtifactId next: ChildNext }
  data Abstained {}
  data Failed { fault: str }
  data Cancelled {}
}
enum AbstentionReason { Unconfigured Launch Credential Quota RateLimit Unavailable }
root data SeatAttempt { attempt: AttemptId route: ModelRoute abstained: opt[AbstentionReason] detail: opt[str] }
root data SeatStatus { seat: i32 attempts: lst[SeatAttempt] end: SeatEnd }
root data UnitSeats { request: RequestId mode: PanelMode min: i32 seats: lst[SeatStatus] }

enum ArtifactKind { Prompt Input Result Transcript Validation Combination Selection Evidence Amendment Panel }
root data ArtifactUpload { project: ProjectId id: ArtifactId attempt: AttemptId kind: ArtifactKind mediaType: str body: str }
root data ArtifactMetadata { project: ProjectId id: ArtifactId attempt: AttemptId kind: ArtifactKind mediaType: str sha256: str bytes: i32 codePoints: i32 actor: Actor receivedAt: i64 }
root data ArtifactPage { metadata: ArtifactMetadata offset: i32 next: i32 hasMore: bit text: str }

enum StopReason { Exited Cancelled OwnerExited InvalidControl LaunchFailed OutputLimit HostFailure StartupDeadline ExecutionDeadline HeartbeatLost Signalled }
enum JobTarget { Run Stop }
enum JobPhase { Preparing Starting Running Stopping Settled Uncertain }
root data JobExit { code: opt[i32] signal: opt[i32] reason: StopReason stdoutBytes: i64 stderrBytes: i64 settled: bit hostFailure: bit }
root data JobRecord {
  workspace: WorkspaceSpec fingerprint: str target: JobTarget phase: JobPhase
  exit: opt[JobExit] problem: opt[str] revision: i64 createdAt: i64 updatedAt: i64
}

root data HarnessSetting {
  harness: Harness executable: str model: str provider: str version: str
  providerExtensions: lst[str] providerEnvironment: set[str]
}
root data HostLimits { startupMillis: i64 heartbeatMillis: i64 graceMillis: i64 killMillis: i64 retainedOutputBytes: i32 }
root data ValidationCheck { name: str command: lst[str] executionMillis: i64 retainedOutputBytes: i32 attempts: i32 revalidations: i32 }
root data SupervisorSettings { stateRoot: str guardian: str harnesses: lst[HarnessSetting] limits: HostLimits checks: lst[ValidationCheck] evaluation: opt[EvaluationScope] integrationTarget: opt[str] }
root data GoverningReport { summary: str }
root data HarnessRoute { harness: Harness model: str provider: str }
enum WorkflowPhase { Explore Plan Work Review Integrate }
enum UpstreamAction { Prepare Report Recheck }
root adt WorkflowRequest {
  data Begin { roots: set[ItemId] }
  data Advance { roots: set[ItemId] through: WorkflowPhase }
  data Review { result: ArtifactId mode: ReviewerMode }
  data Upstream { roots: set[ItemId] action: UpstreamAction }
}
root data WorkflowSubject { result: ArtifactId work: DispatchWork members: lst[ItemRevision] candidate: opt[GitCommit] }
// `mode` is the process mode whose section opens `instructions`: the project's mode when the workflow was activated, as a session of this ownership works it.
root data WorkflowContext { request: WorkflowRequest instructions: str subject: opt[WorkflowSubject] mode: ProcessMode }
root data GoverningInput { project: ProjectConfig routes: lst[HarnessRoute] checks: lst[str] limits: HostLimits integrationTarget: opt[str] request: str workflow: opt[WorkflowContext] }
enum SessionOwnership { Managed Attached }
root data AttachedPiEvent {
  sequence: i64 session: str turn: i64 provider: str model: str timestamp: i64 responseId: opt[str] stopReason: str
  input: opt[i64] output: opt[i64] cacheRead: opt[i64] cacheWrite: opt[i64] reasoning: opt[i64] totalTokens: opt[i64] costUSD: opt[DecimalAmount]
}
root data AttachedPiSample { event: AttachedPiEvent receivedAt: i64 }
root data WorkflowActivation { id: RequestId context: WorkflowContext operatorRequirements: str cycle: opt[CycleId] }
// What a governing session is sent about an activation. The stored record is WorkflowActivation; these repeat no text the session holds.
root data ActiveWorkflow { id: RequestId request: WorkflowRequest cycle: opt[CycleId] mode: ProcessMode }
root adt WorkflowInstructions {
  data Text { value: str }
  // The text is identical to the one the Workflow reply of activation `since` carried in this attached session.
  data Unchanged { since: RequestId }
}
root data WorkflowReceipt { id: RequestId request: WorkflowRequest instructions: WorkflowInstructions subject: opt[WorkflowSubject] cycle: opt[CycleId] mode: ProcessMode }
root data AttachedContext {
  session: SessionId attempt: AttemptId directory: str project: ProjectConfig
  routes: lst[HarnessRoute] checks: lst[str] limits: HostLimits integrationTarget: opt[str]
  instructions: str workflow: opt[ActiveWorkflow] usageCoverage: str
  // The project's process mode now; the next workflow activation takes it.
  mode: ProcessMode
}
root adt SessionCommand {
  data Context {}
  data Workflow { id: RequestId request: WorkflowRequest operatorRequirements: str token: opt[CycleToken] }
  data Instructions {}
  data Bind { token: DriverToken }
  data Driver {}
}
root adt SessionReply {
  data Context { value: AttachedContext }
  data Workflow { value: WorkflowReceipt }
  data Instructions { value: WorkflowActivation }
  data Driver { reply: DriverReply }
  data Failed { fault: Fault }
}
root data NativeManifest { encoding: str mediaType: str bytes: i64 sha256: str parts: lst[ArtifactId] }
root adt HostDelivery {
  data Usage { value: HostUsageInput }
  data Artifact { value: ArtifactUpload }
}
root data DeliveryBatch { entries: lst[HostDelivery] }
root data SupervisorRun {
  project: ProjectConfig assignment: Assignment attempt: Attempt harnessVersion: str
  repository: str base: GitCommit ownership: SessionOwnership
}
root data SupervisorReceipt {
  session: SessionId attempt: AttemptId directory: str phase: JobPhase
  processSucceeded: bit result: opt[ArtifactId] report: opt[GoverningReport] usageDelivered: bit problem: opt[str]
}

enum WorkerMode { Implement Probe ResolveConflict }
enum ExplorerMode { Investigate Research }
enum ReviewerMode { Candidate Plan Audit }
root adt DispatchWork {
  data Explorer { mode: ExplorerMode }
  data Planner {}
  data Worker { mode: WorkerMode }
  data Reviewer { mode: ReviewerMode }
}
root data DispatchRequest {
  request: RequestId work: DispatchWork harness: Harness members: lst[ItemRevision]
  guidance: lst[ItemRevision] artifacts: lst[ArtifactId] previous: opt[ArtifactId]
  fence: Fence limits: HostLimits
}
enum WorkDisposition { CandidateReady Blocked Failed }
enum ReviewVerdict { Accepted ChangesRequested Blocked }
enum PlanDisposition { Proposed Assessed Blocked Abstained }
enum CohortCompatibility { Compatible Unknown Incompatible }
root data CohortCriterion { criterion: i32 checks: set[str] inspection: str }
root data CohortMemberAssessment { member: ItemRevision acceptance: lst[CohortCriterion] }
root data CohortAssessment {
  compatibility: CohortCompatibility objective: str dependencies: str interference: str members: lst[CohortMemberAssessment]
}
enum EvidenceDisposition { Findings Inconclusive Blocked Failed }
root data WorkMember { item: ItemId disposition: WorkDisposition summary: str evidence: lst[str] }
root data ReviewMember { item: ItemId verdict: ReviewVerdict findings: lst[str] }
root data PlanMember { item: ItemId disposition: PlanDisposition summary: str }
root data EvidenceMember {
  item: ItemId disposition: EvidenceDisposition summary: str evidence: lst[Evidence]
  uncertainties: lst[str] requestedProbes: lst[str]
}
root adt ProposedMutation {
  data Create { draft: ItemDraft }
  data Replace { id: ItemId draft: ItemDraft }
  data Produce { producer: ItemId drafts: lst[ItemDraft] milestone: opt[MilestoneRef] }
  data Reference { source: ItemId relation: Relation target: ItemId present: bit }
}
root data LedgerProposal { mutations: lst[ProposedMutation] reason: str }
root data ProposalDraftSummary { ledger: Ledger title: str status: TerminalStatus archived: bit }
root data ProposalFieldChanges {
  body: bit labels: bit content: bit citations: bit evidence: bit provenance: bit operatorConfirmation: bit
}
root adt ProposalOperationSummary {
  data Create { draft: ProposalDraftSummary }
  data Replace { id: ItemId before: ProposalDraftSummary after: ProposalDraftSummary fields: ProposalFieldChanges }
  data Produce { producer: ItemId drafts: lst[ProposalDraftSummary] milestone: opt[MilestoneRef] }
  data Reference { source: ItemId relation: Relation target: ItemId present: bit }
}
root data ProposalPreview {
  result: ArtifactId request: RequestId role: Role members: lst[ItemRevision]
  operations: lst[ProposalOperationSummary] detailsOmitted: bit
}
root adt ChildReport {
  data Evidence { members: lst[EvidenceMember] }
  data Plan { members: lst[PlanMember] proposal: opt[LedgerProposal] assessments: lst[CohortAssessment] }
  data Work { members: lst[WorkMember] }
  data Review { members: lst[ReviewMember] proposal: opt[LedgerProposal] }
}
root data EvidenceFile { path: str artifact: ArtifactId bytes: i64 truncated: bit }
root data RetainedEvidence { files: lst[EvidenceFile] omitted: lst[str] }
root data ChildResult {
  attempt: AttemptId request: DispatchRequest base: GitCommit candidate: opt[GitCommit] report: ChildReport validation: lst[ValidationEvidence]
  evidence: RetainedEvidence
}
root data PartialWork {
  attempt: AttemptId state: AttemptState stdout: ArtifactId stderr: ArtifactId status: opt[ArtifactId] diff: opt[ArtifactId] diffTruncated: bit
  evidence: RetainedEvidence
}
root data ChildPublication {
  project: ProjectId owner: Actor result: opt[ChildResult] status: DispatchStatus outcome: AttemptOutcome
}
enum AdmissionRejection { ClaimLost RevisionsChanged }
root adt AdmissionDecision {
  data Accepted {}
  data Rejected { reason: AdmissionRejection }
}
root data HostAdmissionInput { project: ProjectId artifact: ArtifactId owner: Actor }
root data ResultAdmission {
  artifact: ArtifactMetadata owner: Actor fence: Fence members: lst[ItemRevision] decision: AdmissionDecision decidedAt: i64
}
root id IntegrationId { value: uid }
root data RebaseAttempt { commit: GitCommit validation: lst[ValidationEvidence] }
root data IntegrationRebase { reviewed: GitCommit author: AttemptId validation: lst[ValidationEvidence] failed: lst[RebaseAttempt] }
root data IntegrationIntent {
  id: IntegrationId project: ProjectId owner: Actor repository: str target: str expected: GitCommit candidate: GitCommit
  worker: ArtifactId reviewer: ArtifactId checks: lst[ValidationCheck] fence: Fence members: lst[ItemRevision] change: ChangeRequest
  rebase: opt[IntegrationRebase]
}
root data IntegrationHold {
  id: IntegrationId owner: Actor target: str expected: GitCommit candidate: GitCommit members: lst[ItemRevision]
}
root adt IntegrationObservation {
  data Incorporated { target: GitCommit }
  data NotApplied { reason: str }
}
root adt IntegrationResolution {
  data Pending {}
  data NotApplied { reason: str }
  data Recorded { acknowledgement: ChangeAck observedTarget: GitCommit }
}
root data IntegrationRecord { intent: IntegrationIntent resolution: IntegrationResolution reservedAt: i64 resolvedAt: opt[i64] }
root data CheckoutPlan { intent: IntegrationIntent attached: bit }
root data CheckoutReceipt { intent: IntegrationIntent gitDirectory: str indexSha256: str }
root data CheckoutRefusal { intent: IntegrationIntent reason: str }
root data CodexUsageBinding { thread: uid version: str sessions: str }
root data CodexUsageEnd { before: i64 }
root data CodexUsageFile { path: str fileKey: str }
root data CodexUsageSample {
  thread: uid turn: uid response: str position: i64 occurredAt: i64
  model: opt[str] provider: opt[str] counters: TokenCounts
}
root data CodexResponseOwner { attempt: AttemptId sample: CodexUsageSample }
root data IntegrationTicket { id: IntegrationId reviewer: ArtifactId }
root adt RebaseOutcome {
  data Unneeded {}
  data Applied { reviewed: GitCommit }
  data Conflicted { target: GitCommit }
  data ChecksFailed { target: GitCommit validation: lst[ValidationEvidence] }
  data Refused { target: GitCommit reason: str }
}
root data IntegrationPreview {
  id: IntegrationId reviewer: ArtifactId target: str expected: GitCommit candidate: GitCommit members: lst[ItemRevision]
  rebase: RebaseOutcome
}
enum IntegrationPhase { Preparing Ready Running Pending Recorded NotApplied Failed }
enum IntegrationNext { Wait Confirm Reconcile InspectEvidence Complete }
root data IntegrationStatus { id: IntegrationId phase: IntegrationPhase preview: opt[IntegrationPreview] next: IntegrationNext blocker: opt[str] }
root data IntegrationLocal { intent: IntegrationIntent attempted: bit observation: opt[IntegrationObservation] }
root data CombinationTicket { id: RequestId source: IntegrationId fence: Fence }
root data CombinationPlan {
  request: CombinationTicket project: ProjectId owner: Actor governor: AttemptId repository: str target: str
  observedTarget: GitCommit candidate: GitCommit worker: ArtifactId members: lst[ItemRevision]
}
root data CombinationPreview { plan: ArtifactId worker: ArtifactId members: lst[ItemRevision] fence: Fence target: GitCommit }
enum CombinationPhase { Preparing Ready PublicationPending Failed }
root data CombinationStatus { id: RequestId phase: CombinationPhase preview: opt[CombinationPreview] blocker: opt[str] }
root adt HostIntegration {
  data Reserve { intent: IntegrationIntent }
  data Observe { id: IntegrationId observation: IntegrationObservation }
}
root data HostIntegrationInput { project: ProjectId operation: HostIntegration }
root data ResolvedArtifact { metadata: ArtifactMetadata body: str }
root data ChildInput {
  project: ProjectId request: DispatchRequest members: lst[ItemView] guidance: lst[ItemView]
  artifacts: lst[ResolvedArtifact] previous: opt[ChildResult] operatorRequirements: opt[str]
}
root data ChildExecutionInput { input: ChildInput base: GitCommit checks: lst[ValidationCheck] }
enum ValidationState { Passed Failed Unknown }
root data ValidationEvidence { check: str state: ValidationState artifact: ArtifactId failures: lst[ArtifactId] }
root data ValidationObservation { check: ValidationCheck candidate: GitCommit job: JobRecord stdout: ArtifactId stderr: ArtifactId }
root data ValidationAmendment { result: ArtifactId candidate: GitCommit author: AttemptId round: i32 validation: lst[ValidationEvidence] }
enum RevalidationPhase { Running Completed Failed }
root data RevalidationStatus {
  id: RequestId result: ArtifactId phase: RevalidationPhase amendment: opt[ArtifactId] validation: lst[ValidationEvidence] blocker: opt[str]
}
enum DeclaredCheckPhase { Starting Running Publishing Completed Failed Unknown }
root data DeclaredCheckTicket { parent: AttemptId check: ValidationCheck workspace: WorkspaceSpec fingerprint: str failures: lst[ArtifactId] }
root data DeclaredCheckStatus { name: str job: AttemptId phase: DeclaredCheckPhase evidence: opt[ValidationEvidence] blocker: opt[str] }
enum DispatchPhase { Preparing Running Stopping Validating Publishing Completed Failed Cancelled Unknown PublicationPending Abstained }
enum ChildNext { Wait Plan Review Revise ResolveBlocker Retry ConsiderAcceptance ConsiderProposal ConsiderGrouping InspectEvidence RetryDelivery Arbitrate }
root data ChildCounts {
  ready: i32 accepted: i32 changesRequested: i32 blocked: i32 failed: i32 validationFailed: i32 validationUnknown: i32
  proposed: i32 evidence: i32 abstained: i32 assessed: i32 validationIntermittent: i32
}
root data WorkspaceState { admission: WorkspaceAdmission directory: opt[str] }
root data DispatchStatus {
  request: RequestId attempt: AttemptId phase: DispatchPhase process: opt[JobPhase] members: lst[ItemId]
  counts: ChildCounts next: ChildNext blocker: opt[str] result: opt[ArtifactId] partial: opt[ArtifactId] detailsOmitted: bit usageDelivered: bit
  workspace: opt[WorkspaceState] quietMillis: opt[i64]
}
root data DispatchTicket { request: DispatchRequest assignment: Assignment attempt: Attempt profile: HarnessSetting selection: opt[ArtifactId] }
root data CohortRequest {
  request: RequestId roots: set[ItemId] work: DispatchWork guidance: lst[ItemRevision] artifacts: lst[ArtifactId]
  previous: opt[ArtifactId] limits: HostLimits
}
enum CohortReason {
  CommonProducer CompatibleAssessment AssessmentRequired UnknownAssessment IncompatibleAssessment
  NoCommonProducer ExactPrevious Single InputBound Claimed Deferred NotReady ReviewAccepted ReviewBlocked FreshFromBase CandidateContinuity
  PlannerOrganisation NoMilestone ClosedMilestone
}
root data CohortChoice {
  id: RequestId work: DispatchWork members: lst[ItemRevision] guidance: lst[ItemRevision] artifacts: lst[ArtifactId]
  previous: opt[ArtifactId] limits: HostLimits cohort: opt[uid] reason: CohortReason witness: opt[ItemId]
}
root data CohortCounts { discovered: i32 selected: i32 inspected: i32 excluded: i32 unexamined: i32 notReady: i32 ineligible: i32 remaining: i32 }
root data CohortDecision { id: RequestId artifact: ArtifactId counts: CohortCounts choices: lst[CohortChoice] }
// What a governing session is sent about a selection: its choices without the limits its own request stated.
// The retained record is CohortEvidence with CohortDecision and CohortChoice.
root data OfferedChoice {
  id: RequestId work: DispatchWork members: lst[ItemRevision] guidance: lst[ItemRevision] artifacts: lst[ArtifactId]
  previous: opt[ArtifactId] cohort: opt[uid] reason: CohortReason witness: opt[ItemId]
}
root data CohortOffer { id: RequestId artifact: ArtifactId counts: CohortCounts choices: lst[OfferedChoice] }
root data CohortConsidered { members: lst[ItemRevision] reason: CohortReason fingerprint: opt[str] }
root data CohortEvidence { request: CohortRequest decision: CohortDecision considered: lst[CohortConsidered] }
// What `cq wait` reads: the governing host appends one event to `units.jsonl` of its session directory when it starts working on
// a unit and when it stops, with how the unit stands then. Phase and next are the unit's own enumerations, as text.
enum SessionUnitKind { Attempt Integration Combination Revalidation }
root data SessionUnit { kind: SessionUnitKind id: uid members: lst[ItemId] }
root data UnitEnd { unit: SessionUnit phase: str next: opt[str] blocker: opt[str] }
root adt SessionUnitEvent {
  data Started { unit: SessionUnit }
  data Ended { end: UnitEnd }
}
// What an attached host leaves in its checkout's CQ directory for the hooks and the `cq wait` of that checkout: where its session
// directory is, and the command line its harness integration approved for waiting, when it approved one.
root data AttachedHostRecord { directory: str waitCommand: opt[str] }
root adt WaitOutcome {
  data Ended { units: lst[UnitEnd] active: lst[SessionUnit] }
  data Idle {}
  data HostGone { active: lst[SessionUnit] }
}
root adt DispatchCommand {
  data Select { request: CohortRequest }
  data StartChoice { choice: RequestId harness: Harness fence: Fence }
  data Start { request: DispatchRequest }
  data Status { attempt: AttemptId waitMillis: i32 }
  data Cancel { attempt: AttemptId }
  data Seats { attempt: AttemptId }
  data PrepareIntegration { id: IntegrationId reviewer: ArtifactId }
  data Integrate { id: IntegrationId }
  data IntegrationStatus { id: IntegrationId waitMillis: i32 }
  data Combine { id: RequestId source: IntegrationId fence: Fence }
  data CombinationStatus { id: RequestId waitMillis: i32 }
  data Revalidate { id: RequestId result: ArtifactId fence: Fence }
  data DiscardIntegration { id: IntegrationId }
}
root adt DispatchReply {
  data Selection { value: CohortOffer }
  data Status { value: DispatchStatus }
  data Seats { value: UnitSeats }
  data Integration { value: IntegrationStatus }
  data Combination { value: CombinationStatus }
  data Revalidation { value: RevalidationStatus }
  data Failed { fault: Fault }
}
root adt WorkspaceCommand {
  data Entries { path: str after: opt[str] limit: i32 }
  data Read { path: str offset: i32 limit: i32 }
  data MergeReport { offset: i32 limit: i32 }
  data Check { name: str waitMillis: i32 }
}
enum WorkspaceEntryKind { File Directory Symlink }
root data WorkspaceEntry { name: str kind: WorkspaceEntryKind }
root data WorkspacePage { entries: lst[WorkspaceEntry] after: opt[str] hasMore: bit }
root data WorkspaceText { path: str offset: i32 next: i32 hasMore: bit text: str }
root adt WorkspaceReply {
  data Listed { page: WorkspacePage }
  data Text { page: WorkspaceText }
  data Check { value: DeclaredCheckStatus }
  data Failed { fault: Fault }
}

root data CatalogPrompt { resource: str text: str }
root data CatalogArgument { field: str flag: str value: str summary: str choices: lst[str] required: bit note: opt[str] }
root data CatalogAlias { harness: Harness alias: str path: str body: str }
root data CatalogCommand {
  command: str variant: str description: str parameters: lst[CatalogArgument]
  template: CatalogPrompt instructions: lst[CatalogPrompt] aliases: lst[CatalogAlias]
}
enum CatalogToolAccess { Enabled Unselected Denied }
enum CatalogMcpTarget { Domain Local }
root data CatalogTool { name: str access: CatalogToolAccess }
root data CatalogToolset { target: CatalogMcpTarget server: str tools: lst[CatalogTool] }
root data CatalogTools { mcp: lst[CatalogToolset] builtin: lst[CatalogTool] edits: bit workspaceCheck: bit }
root data CatalogAgentHarness { harness: Harness prompt: str outputSchema: str tools: CatalogTools }
root data CatalogAgent {
  work: DispatchWork role: Role mode: opt[str] prompt: CatalogPrompt
  inputType: str inputSchema: str report: str outputSchema: str workspaceSchema: str
  harnesses: lst[CatalogAgentHarness] inputExample: ChildExecutionInput outputExample: ChildReport
}
// `modeEffect` says when a change of the process mode takes effect.
root data HelpCatalog { commands: lst[CatalogCommand] agents: lst[CatalogAgent] modes: lst[CatalogMode] modeEffect: str }
